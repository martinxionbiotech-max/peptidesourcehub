const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What peptides do you manufacture?", "acceptedAnswer": {"@type": "Answer", "text": "58 standard peptide SKUs across 6 categories: Metabolic, Healing & Recovery, Cosmetic & Skin, Muscle Growth, Nootropic & Anti-Aging, and Specialty Stacks."}}, {"@type": "Question", "name": "What is your minimum purity standard?", "acceptedAnswer": {"@type": "Answer", "text": "≥99% by HPLC with ESI-MS identity confirmation for every product. Batch-specific Certificate of Analysis included with every order."}}, {"@type": "Question", "name": "What are your wholesale pricing tiers?", "acceptedAnswer": {"@type": "Answer", "text": "Tiered pricing: 2-5 kits (10-20% off), 6-20 kits (25-40%), 21-50 (40-55%), 50+ (55-70%). Annual contracts: custom pricing. Published, transparent tiers."}}, {"@type": "Question", "name": "Where do you ship?", "acceptedAnswer": {"@type": "Answer", "text": "North America, EU, UK, Australia, NZ, Japan, South Korea, Singapore, and most APAC regions via DHL/FedEx/UPS/TNT. Free shipping on orders over $800."}}, {"@type": "Question", "name": "How do I place a wholesale order?", "acceptedAnswer": {"@type": "Answer", "text": "Contact Dr. Aaron Wang via WhatsApp (+64 20 431 0558), Telegram (@DrAaronWang), email (aaron@senobiocorp.com), or our contact page. Quotes within 24 hours."}}]};
