---
import PageLayout from "../layouts/PageLayout.astro";
---
<PageLayout title="Shipping & Delivery Policy" description="Worldwide shipping via FedEx, UPS, DHL, TNT. Tracking within 3 business days. Free shipping on orders over $500. Buyer responsible for import duties.">
<section class="section bg-white">
  <div class="container-narrow mx-auto px-4">
    <h1>Shipping & Delivery Policy</h1>
    <div class="mt-8 space-y-6">
      <div class="card"><h2 class="font-bold mb-2">Coverage</h2><p class="text-gray-600">North America, European Union, United Kingdom, Australia, New Zealand, Asia, and most other regions.</p></div>
      <div class="card"><h2 class="font-bold mb-2">Carriers</h2><p class="text-gray-600">FedEx, UPS, DHL, or TNT depending on destination. Carrier selection optimized for your region.</p></div>
      <div class="card"><h2 class="font-bold mb-2">Tracking</h2><p class="text-gray-600">Tracking number issued within 3 business days after order confirmation. Transit typically 5–10 business days for major markets.</p></div>
      <div class="card"><h2 class="font-bold mb-2">Free Shipping</h2><p class="text-gray-600">Orders over $500 qualify for free worldwide delivery.</p></div>
      <div class="card"><h2 class="font-bold mb-2">Duties & Customs</h2><p class="text-gray-600">Buyer is responsible for import duties, taxes, and customs clearance. We provide necessary export documentation.</p></div>
      <div class="card bg-surface border-accent/20">
        <p class="text-primary-light font-medium text-sm italic">FOR LABORATORY RESEARCH USE ONLY. NOT FOR MEDICAL USE.</p>
      </div>
    </div>
  </div>
</section>
</PageLayout>
