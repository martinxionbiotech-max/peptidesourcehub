---
import PageLayout from "../layouts/PageLayout.astro";
import RuoNotice from "../components/RuoNotice.astro";
import { PRICE_LIST_URL, PRICE_LIST_UPDATED, VOLUME_DISCOUNT_TEXT } from "../data/pricing";

/** OEM / 定制流程页（P3）—— 只描述流程与所需资料；起订量、时间线一律「以报价单确认为准」，不新增承诺。 */

const steps = [
  ["1", "Enquiry & specification", "Send the product, the kit configuration (mg per vial, vials per kit) and the quantity. If you are asking for a blend or a custom ratio, state the target composition."],
  ["2", "Feasibility & MOQ confirmation", "We confirm whether the specification is feasible from our synthesis and fill lines, and state the minimum order quantity for that configuration. Nothing on this page overrides the figure in your quotation."],
  ["3", "Artwork & label review", "You supply label artwork (vector preferred) and the exact wording. We check it for the mandatory research-use statement and for claims we cannot substantiate."],
  ["4", "Quotation & proforma invoice", "Written quotation with unit price, MOQ, lead time, incoterms, payment terms and packing specification. Your order is the configuration stated on that document."],
  ["5", "Production & fill", "Synthesis, purification, lyophilization and fill to the agreed configuration, with in-process checks recorded against the lot."],
  ["6", "QC & documentation", "Batch-specific COA (HPLC purity, ESI-MS identity, appearance, moisture) plus commercial invoice, packing list and any SDS or end-use statement requested at order stage."],
  ["7", "Dispatch", "Export packing, carrier handover and tracking. Cold-chain and desiccant options are selected at quotation according to the destination."],
];

const customisable = [
  ["Vial size and fill", "Milligram fill per vial within validated ranges, subject to the product's handling characteristics."],
  ["Vials per kit", "Standard kits are 10 vials; other counts are confirmed per product at quotation."],
  ["Kit configuration", "Single peptide, fixed-ratio blend, or a multi-component kit such as the GLOW and KLOW configurations."],
  ["Label and carton artwork", "Your brand artwork on vial labels and cartons, subject to the mandatory research-use statement remaining intact and legible."],
  ["Documentation pack", "COA, SDS, end-use statement and certificate of origin supplied to your format requirements where we can do so accurately."],
  ["Blind / neutral presentation", "Unbranded presentation for distributors who label locally. This does not mean unexplained material: your documents and ours must still describe the product accurately."],
];

const needFromYou = [
  "Target specification: product, fill per vial, vials per kit, total quantity.",
  "Label artwork and the exact text you want printed, including your company identifiers and any address for returns.",
  "The consignee entity and destination, so that packing and the document pack match the import route.",
  "Requested documents (SDS, end-use statement, certificate of origin, specific COA layout).",
  "A contact who can approve artwork — label approval is the step that most often lengthens a project.",
];

const limits = [
  "We do not print regulatory or certification claims on a private label unless they can be substantiated against a current certificate, and we will say so if they cannot.",
  "We do not remove the research-use-only statement from a label. It is a condition of supply, not an option.",
  "We do not help a label imply a human or veterinary use, a cosmetic use, or a therapeutic purpose.",
  "We do not state fixed MOQ or lead times on this page: both are configuration-specific and are confirmed in your quotation.",
];

const faq = [
  ["What is the minimum order quantity for a custom configuration?", "It depends on the product and configuration, and it is stated in your quotation rather than on this page. For standard catalogue kits the minimum is 1 kit (10 vials); custom fills, blends and private-label runs carry a higher minimum because of the set-up involved."],
  ["How long does an OEM project take?", "It depends on whether artwork is ready and whether the configuration needs a new synthesis batch. The lead time is confirmed in the quotation. Projects stall most often at label approval, so approving artwork early is the biggest available time saving."],
  ["Can you produce a blend that is not in your catalogue?", "Yes, if the components are catalogue products and their combined handling is compatible. Custom ratios are confirmed at quotation; we will tell you if the requested combination is not feasible."],
  ["Will you print my certification claims on the label?", "Only if the claim can be substantiated against a current certificate you provide. We will not print an ISO, GMP or pharmacopoeia claim on a private label without one."],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://peptidesourcehub.net/oem-custom/#webpage",
    name: "OEM & Private-Label Research Peptides",
    description:
      "How OEM and private-label peptide runs work: the seven process steps, what can be customised, the information we need from you, and the claims we will not print.",
    url: "https://peptidesourcehub.net/oem-custom/",
    isPartOf: { "@type": "WebSite", "@id": "https://peptidesourcehub.net/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f[0],
      acceptedAnswer: { "@type": "Answer", text: f[1] },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://peptidesourcehub.net/" },
      { "@type": "ListItem", position: 2, name: "Products", item: "https://peptidesourcehub.net/products/" },
      { "@type": "ListItem", position: 3, name: "OEM & Private Label" },
    ],
  },
];
---

<PageLayout
  title="OEM & Private Label Peptides"
  description="How OEM and private-label peptide runs work: the seven process steps, what can be customised, what we need from you, and the claims we will not print."
  jsonLd={jsonLd}
>
<RuoNotice />

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <span class="text-accent">OEM &amp; Private Label</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">OEM &amp; Private-Label Research Peptides</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-3xl">
      Private-label vials, custom kit configurations and fixed-ratio blends, produced on the same lines as our catalogue and documented batch by batch. This page describes the process and the information we need — the commercial terms come from your quotation.
    </p>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">1. The process, step by step</h2>
    <div class="max-w-4xl mx-auto space-y-3">
      {steps.map((s) => (
        <div class="card p-5 flex gap-4">
          <span class="shrink-0 w-9 h-9 rounded-xl bg-accent/15 text-accent-dark font-bold flex items-center justify-center">{s[0]}</span>
          <div>
            <h3 class="font-bold text-sm mb-1">{s[1]}</h3>
            <p class="text-gray-600 text-sm">{s[2]}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="text-gray-500 text-xs mt-4 text-center max-w-3xl mx-auto">
      Minimum order quantities and lead times are configuration-specific and are confirmed in writing in your quotation. No figure on this page constitutes a commitment.
    </p>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">2. What can be customised</h2>
    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-primary">Element</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">What is possible</th>
          </tr>
        </thead>
        <tbody>
          {customisable.map((c, i) => (
            <tr class={`border-b border-gray-100 ${i % 2 === 0 ? "bg-white" : "bg-gray-50/50"}`}>
              <td class="py-3 px-4 font-semibold text-primary text-sm">{c[0]}</td>
              <td class="py-3 px-4 text-gray-600 text-sm">{c[1]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      <div class="card p-6">
        <h2 class="font-bold mb-4">3. What we need from you</h2>
        <ul class="space-y-2 list-disc pl-5">
          {needFromYou.map((n) => (
            <li class="text-gray-600 text-sm">{n}</li>
          ))}
        </ul>
      </div>
      <div class="card p-6">
        <h2 class="font-bold mb-4">4. What we will not do on a private label</h2>
        <ul class="space-y-2 list-disc pl-5">
          {limits.map((n) => (
            <li class="text-gray-600 text-sm">{n}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="mb-4">5. Commercial reference points</h2>
    <div class="max-w-3xl text-sm text-gray-700 space-y-3">
      <p>Standard catalogue kits are sold at the published list price, {VOLUME_DISCOUNT_TEXT}. Custom configurations and private-label runs are quoted per project, because fill size, artwork and documentation layout all affect cost.</p>
      <p>The engineering cost of a custom run shows up at the front end: feasibility review, fill validation and artwork approval. Buyers who start with a standard kit to validate the product, then move to a private label, generally spend less than buyers who begin with a bespoke configuration.</p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href={PRICE_LIST_URL} download class="btn-outline">Price list (PDF, {PRICE_LIST_UPDATED})</a>
        <a href="/products/specialty-stacks/" class="btn-outline">Existing blend configurations</a>
        <a href="/import-compliance/" class="btn-outline">Import documentation</a>
      </div>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">FAQ</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      {faq.map((f) => (
        <details class="card group cursor-pointer">
          <summary class="font-semibold text-primary hover:text-accent">{f[0]}</summary>
          <p class="mt-3 text-gray-600 text-sm">{f[1]}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Start a private-label project</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Send the specification, target quantity and artwork status. You will get a feasibility answer, the MOQ for that configuration, and a written quotation.</p>
    <a href="/contact/" class="btn-primary text-lg">Request an OEM Quotation</a>
  </div>
</section>

<div class="text-center py-6 bg-surface">
  <a href="/products/" class="text-accent-dark font-medium hover:underline">← Back to All Products</a>
</div>

</PageLayout>
