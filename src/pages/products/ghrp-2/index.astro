---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "GHRP-2 Wholesale — Research-Grade Potent Ghrelin Receptor Agonist Peptide",
  "description": "Factory-direct GHRP-2 wholesale. CAS 158861-67-7, ~817.0 Da. ≥99% HPLC. Potent GHS-R1a agonist. COA included.",
  "sku": "PSH-GHRP2-5MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","158861-67-7"],
  ["Sequence","D-Ala-D-2-Nal-Ala-Trp-D-Phe-Lys-NH₂"],
  ["Amino Acids","6 (D-Ala¹, D-2-Nal², D-Phe⁵)"],
  ["Molecular Formula","C₄₅H₅₅N₉O₆"],
  ["Molecular Weight","~817.0 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile or bacteriostatic water"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","5 mg × 10 vials","GH pulse research; evaluation"],
  ["Bulk Kit","10 mg × 10 vials","Chronic protocols; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label"]
];

const focusAreas = [
  ["GH Pulse Induction","Rapid, potent GH release via GHS-R1a activation on pituitary"],
  ["Pulsatile GH Research","Sharp GH spikes — compatible with post-exercise window protocols"],
  ["Appetite Signaling","Ghrelin pathway activation — feeding behavior studies"],
  ["IGF-1 Axis","GH-mediated hepatic IGF-1 production cascade"]
];

const mechanisms = [
  ["GHS-R1a Agonism","Potent ghrelin receptor activation → PLC → IP₃ → Ca²⁺ mobilization → GH exocytosis"],
  ["GHRH Potentiation","GHS-R and GHRH-R signaling converge on somatotroph → synergistic cAMP/Ca²⁺ response"],
  ["Somatostatin Antagonism","GHS-R activation reduces hypothalamic somatostatin release → permissive GH secretion"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~817.0 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Chiral Purity","Chiral HPLC","D-amino acids verified"],
  ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "How potent is GHRP-2 vs other GH secretagogues?", "acceptedAnswer": { "@type": "Answer", "text": "GHRP-2 is among the most potent GHS-R1a agonists, producing GH elevations exceeding GHRP-6 and Ipamorelin at equivalent doses. However, this potency comes with broader receptor profile including stronger appetite stimulation." } },
    { "@type": "Question", "name": "What distinguishes GHRP-2 from Ipamorelin?", "acceptedAnswer": { "@type": "Answer", "text": "GHRP-2: more potent GH release, stronger hunger signaling, potential cortisol elevation. Ipamorelin: cleaner GH pulse, minimal hunger, minimal cortisol. Choice depends on whether maximum amplitude or receptor selectivity is the priority." } },
    { "@type": "Question", "name": "What is the origin of GHRP-2?", "acceptedAnswer": { "@type": "Answer", "text": "GHRP-2 (Pralmorelin) was developed by Kaken Pharmaceutical in Japan through systematic modification of met-enkephalin derivatives. D-amino acid substitutions provide enzymatic resistance while maintaining high GHS-R1a binding affinity." } },
    { "@type": "Question", "name": "How should GHRP-2 be stored?", "acceptedAnswer": { "@type": "Answer", "text": "Lyophilized: 2–8°C, desiccated, 24-month stability. After reconstitution, aliquot and store at -20°C. Avoid freeze-thaw cycles. D-amino acid modifications provide good solution stability." } },
    { "@type": "Question", "name": "Can GHRP-2 be combined with CJC-1295?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — common research combination. CJC-1295 provides sustained GHRH signal; GHRP-2 provides potent ghrelin receptor pulse. CJC-1295 (no DAC) + GHRP-2 is particularly suited for pulsatile GH protocol research." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Muscle Growth", "item": "https://peptidesourcehub.net/products/muscle-growth/" },
    { "@type": "ListItem", "position": 4, "name": "GHRP-2" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="GHRP-2 | Buy Wholesale"
  description="Factory-direct GHRP-2 wholesale. CAS 158861-67-7, ~817.0 Da. ≥99% HPLC. Potent GHS-R1a agonist. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/muscle-growth/" class="text-gray-400 hover:text-white">Muscle Growth</a><span class="text-gray-600">/</span>
      <span class="text-accent">GHRP-2</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">GHRP-2 Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Growth Hormone Releasing Peptide-2 — potent ghrelin mimetic for GH pulse research, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">GHRP-2 (also known as Pralmorelin) is a synthetic hexapeptide ghrelin receptor agonist. It is one of the most potent GH secretagogues in the GHRP family, producing a rapid, robust GH pulse. Developed through structure-activity relationship studies of met-enkephalin derivatives, GHRP-2 features D-amino acid modifications (D-Ala¹, D-2-Nal², D-Phe⁵) that confer both metabolic stability and high receptor affinity.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How potent is GHRP-2 vs other GH secretagogues?</summary><p class="mt-3 text-gray-600 text-sm">GHRP-2 is among the most potent GHS-R1a agonists, producing GH elevations exceeding GHRP-6 and Ipamorelin at equivalent doses. However, this potency comes with broader receptor profile including stronger appetite stimulation.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What distinguishes GHRP-2 from Ipamorelin?</summary><p class="mt-3 text-gray-600 text-sm">GHRP-2: more potent GH release, stronger hunger signaling, potential cortisol elevation. Ipamorelin: cleaner GH pulse, minimal hunger, minimal cortisol. Choice depends on whether maximum amplitude or receptor selectivity is the priority.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the origin of GHRP-2?</summary><p class="mt-3 text-gray-600 text-sm">GHRP-2 (Pralmorelin) was developed by Kaken Pharmaceutical in Japan through systematic modification of met-enkephalin derivatives. D-amino acid substitutions provide enzymatic resistance while maintaining high GHS-R1a binding affinity.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How should GHRP-2 be stored?</summary><p class="mt-3 text-gray-600 text-sm">Lyophilized: 2–8°C, desiccated, 24-month stability. After reconstitution, aliquot and store at -20°C. Avoid freeze-thaw cycles. D-amino acid modifications provide good solution stability.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Can GHRP-2 be combined with CJC-1295?</summary><p class="mt-3 text-gray-600 text-sm">Yes — common research combination. CJC-1295 provides sustained GHRH signal; GHRP-2 provides potent ghrelin receptor pulse. CJC-1295 (no DAC) + GHRP-2 is particularly suited for pulsatile GH protocol research.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Ipamorelin</span><span class="text-gray-500 text-xs">Selective GHS-R agonist</span></a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">GHRP-6</span><span class="text-gray-500 text-xs">Ghrelin mimetic</span></a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">CJC-1295 (DAC)</span><span class="text-gray-500 text-xs">Sustained GHRH</span></a>
      <a href="/products/hgh/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">HGH</span><span class="text-gray-500 text-xs">Direct GH receptor agonist</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. GHRP-2 is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
