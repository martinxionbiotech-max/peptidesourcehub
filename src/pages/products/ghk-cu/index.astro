---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "GHK-Cu Wholesale — Copper Tripeptide-1",
  "description": "GHK-Cu (Copper Tripeptide-1) lyophilized powder. CAS 49557-75-7, ~340.4 Da. ≥99% HPLC, blue powder. Collagen synthesis and skin research tool. COA included. Tiered wholesale pricing.",
  "sku": "PSH-GHKCU-50MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","49557-75-7"],
  ["Sequence","H-Gly-His-Lys-OH complexed with Cu²⁺ (square-planar, log K ~16)"],
  ["Amino Acids","3 (tripeptide)"],
  ["Molecular Weight","~340.38 Da (free peptide)"],
  ["Appearance","Blue to blue-purple lyophilized powder (Cu²⁺ complex)"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Freely soluble in water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light (light-sensitive)"],
];

const configs = [
  ["Standard Kit","50 mg × 10 vials","Dermatological/cosmetic research"],
  ["Bulk Kit","100 mg × 10 vials","High-volume; formulation studies"],
  ["Custom","Custom mg × custom vials","OEM; cosmetic ingredient supply"],
];

const focusAreas = [
  ["Collagen Synthesis","Stimulates Type I, III, IV collagen in fibroblasts"],
  ["Wound Healing","Accelerated closure in full/partial-thickness models"],
  ["Angiogenesis","Endothelial proliferation; capillary tube formation"],
  ["Antioxidant","SOD-like activity; ROS reduction"],
  ["ECM Remodeling","Upregulates decorin for collagen fibril organization"],
  ["Anti-Inflammatory","Reduces TNF-α and TGF-β1 in skin inflammation models"],
  ["Hair Follicle","Dermal papilla cell proliferation; anagen phase extension"],
  ["Skin Remodeling","Increases epidermal thickness; dermal collagen density"],
];

const applications = [
  ["Dermatological Research","Fibroblast collagen synthesis","1–10 μg/mL"],
  ["Cosmetic Formulation","Topical formulation; transdermal penetration","0.05–0.5% w/w"],
  ["Wound Healing","Scratch assay; wound contraction","1–100 μg/mL"],
  ["Anti-Aging","Senescence markers; antioxidant capacity","Varies by model"],
  ["Hair Research","Dermal papilla proliferation; follicle organ culture","0.1–10 μg/mL"],
];

const qcSpecs = [
  ["Purity (HPLC)","HPLC at 214 nm","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~340.4 Da; Cu complex confirmed"],
  ["Copper Content","ICP-OES / colorimetric","1:1 Cu:peptide ±5%"],
  ["Appearance","Visual","Blue to blue-purple powder"],
  ["Peptide Content","AAA / nitrogen","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"],
];

const pricing = [
  ["1 kit","List price","Evaluation; protocol development"],
  ["2–5 kits","10–20% off","Small cosmetic R&D labs"],
  ["6–20 kits","25–40% off","Mid-size ingredient distributors"],
  ["21–50 kits","40–55% off","Regional ingredient suppliers"],
  ["50+ kits","55–70% off","Large formulators; OEM"],
];
const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is GHK-Cu and how is quality verified?", "acceptedAnswer": {"@type": "Answer", "text": "Copper tripeptide complex (MW ~340.4 Da). Sequence Gly-His-Lys chelating Cu²⁺. ≥99% HPLC, ESI-MS, UV-Vis 600nm verifies copper chelation."}}, {"@type": "Question", "name": "Why does GHK-Cu appear blue?", "acceptedAnswer": {"@type": "Answer", "text": "The characteristic blue color confirms Cu²⁺ chelation — a quality indicator, not a contaminant. 600nm absorbance peak."}}, {"@type": "Question", "name": "How should GHK-Cu be stored?", "acceptedAnswer": {"@type": "Answer", "text": "Lyophilized: 2-8°C, desiccated, protected from light. The copper complex is photolabile. Reconstituted: use tinted vials or wrap in foil."}}, {"@type": "Question", "name": "What concentrations of GHK-Cu are available?", "acceptedAnswer": {"@type": "Answer", "text": "Standard: 50mg (single vial). Bulk: 50mg × 10 vials kit. Custom concentrations available on request."}}, {"@type": "Question", "name": "What documentation is included with GHK-Cu?", "acceptedAnswer": {"@type": "Answer", "text": "COA, commercial invoice, packing list. Additional analytical data (HPLC chromatogram, MS spectrum, UV-Vis) on request."}}]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Cosmetic &amp; Skin", "item": "https://peptidesourcehub.com/products/cosmetic-skin/" },
    { "@type": "ListItem", "position": 4, "name": "GHK-Cu Wholesale" }
  ]
