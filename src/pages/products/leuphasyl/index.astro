---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Leuphasyl Wholesale — Research-Grade Pentapeptide-18 Enkephalin Analogue Peptide",
  "description": "Factory-direct Leuphasyl wholesale. MW ~623.7 Da. ≥99% HPLC. Pentapeptide-18 — δ-opioid receptor agonist. COA included.",
  "sku": "PSH-LEUPH-10MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","— (Pentapeptide-18)"],
  ["Sequence","Tyr-D-Ala-Gly-Phe-Leu-OH"],
  ["Amino Acids","5 (D-Ala² substitution)"],
  ["Molecular Formula","C₃₃H₄₅N₅O₈"],
  ["Molecular Weight","~623.7 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water; cosmetic formulation-compatible"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","10 mg × 10 vials","Fine line models; evaluation"],
  ["Bulk Kit","50 mg × 10 vials","Product development; pilot batches"],
  ["Custom","Custom mg × custom vials","OEM; private-label cosmetics"]
];

const focusAreas = [
  ["Fine Lines","Periorbital and perioral fine line reduction in topical models"],
  ["Muscle Tone Modulation","Calcium channel-mediated smooth muscle relaxation"],
  ["Expression Modulation","Enkephalin receptor-mediated neuromuscular signaling"],
  ["Cosmetic Formulations","Topical delivery of enkephalin analogue peptides"]
];

const mechanisms = [
  ["δ-Opioid Receptor Agonism","Enkephalin analogue → δ-opioid receptor (DOR) activation → reduced neuronal excitability"],
  ["Ca²⁺ Channel Modulation","DOR-mediated inhibition of voltage-gated calcium channels → reduced calcium influx"],
  ["ACh Release Reduction","Decreased intracellular Ca²⁺ → reduced vesicular acetylcholine release at NMJ"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~623.7 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is Leuphasyl and how does it work?", "acceptedAnswer": { "@type": "Answer", "text": "Leuphasyl (Pentapeptide-18) is a synthetic enkephalin analogue pentapeptide with a D-Ala² substitution. It activates δ-opioid receptors, which modulate voltage-gated calcium channels — reducing calcium influx and consequently decreasing ACh release at the NMJ." } },
    { "@type": "Question", "name": "How does Leuphasyl differ from Snap-8 and Argireline?", "acceptedAnswer": { "@type": "Answer", "text": "Mechanistically: Leuphasyl targets opioid receptors → calcium channel modulation. Snap-8 and Argireline target SNARE complex → vesicle docking inhibition. Leuphasyl is preferred for fine line models; Snap-8/Argireline for deeper expression lines." } },
    { "@type": "Question", "name": "What does the D-Ala² substitution do?", "acceptedAnswer": { "@type": "Answer", "text": "The D-Ala² substitution replaces natural L-Ala with D-Ala, conferring resistance to aminopeptidase degradation. This significantly extends half-life compared to natural enkephalins, making it viable for topical formulation research." } },
    { "@type": "Question", "name": "Is Leuphasyl stable in topical formulations?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. As a short pentapeptide (~623.7 Da), Leuphasyl shows good stability at pH 5.0–7.0. Small size facilitates stratum corneum penetration in topical models." } },
    { "@type": "Question", "name": "What is the standard purity specification?", "acceptedAnswer": { "@type": "Answer", "text": "≥99% by HPLC with ESI-MS identity. The D-Ala² substitution is verified by chiral amino acid analysis. Batch-specific COA included." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Cosmetic &amp; Skin", "item": "https://peptidesourcehub.com/products/cosmetic-skin/" },
    { "@type": "ListItem", "position": 4, "name": "Leuphasyl" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="Leuphasyl Wholesale — Research-Grade Pentapeptide-18 Enkephalin Analogue Peptide"
  description="Factory-direct Leuphasyl wholesale. MW ~623.7 Da. ≥99% HPLC. Pentapeptide-18 — δ-opioid receptor agonist. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/cosmetic-skin/" class="text-gray-400 hover:text-white">Cosmetic &amp; Skin</a><span class="text-gray-600">/</span>
      <span class="text-accent">Leuphasyl</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Leuphasyl Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Pentapeptide-18 — enkephalin analogue for fine line & calcium channel modulation research, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">Leuphasyl (Pentapeptide-18) is a synthetic enkephalin analogue pentapeptide featuring a D-Ala² substitution that confers resistance to enzymatic degradation. Unlike Snap-8 and Argireline — which target SNARE-mediated vesicle docking — Leuphasyl operates through a fundamentally different mechanism: δ-opioid receptor (DOR) agonism leading to modulation of voltage-gated calcium channels. This reduces neuronal calcium influx, which in turn decreases acetylcholine release at the neuromuscular junction.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is Leuphasyl and how does it work?</summary><p class="mt-3 text-gray-600 text-sm">Leuphasyl (Pentapeptide-18) is a synthetic enkephalin analogue pentapeptide with a D-Ala² substitution. It activates δ-opioid receptors, which modulate voltage-gated calcium channels — reducing calcium influx and consequently decreasing ACh release at the NMJ.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Leuphasyl differ from Snap-8 and Argireline?</summary><p class="mt-3 text-gray-600 text-sm">Mechanistically: Leuphasyl targets opioid receptors → calcium channel modulation. Snap-8 and Argireline target SNARE complex → vesicle docking inhibition. Leuphasyl is preferred for fine line models; Snap-8/Argireline for deeper expression lines.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What does the D-Ala² substitution do?</summary><p class="mt-3 text-gray-600 text-sm">The D-Ala² substitution replaces natural L-Ala with D-Ala, conferring resistance to aminopeptidase degradation. This significantly extends half-life compared to natural enkephalins, making it viable for topical formulation research.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Is Leuphasyl stable in topical formulations?</summary><p class="mt-3 text-gray-600 text-sm">Yes. As a short pentapeptide (~623.7 Da), Leuphasyl shows good stability at pH 5.0–7.0. Small size facilitates stratum corneum penetration in topical models.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the standard purity specification?</summary><p class="mt-3 text-gray-600 text-sm">≥99% by HPLC with ESI-MS identity. The D-Ala² substitution is verified by chiral amino acid analysis. Batch-specific COA included.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Snap-8</span><span class="text-gray-500 text-xs">Acetyl octapeptide-3</span></a>
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Argireline</span><span class="text-gray-500 text-xs">Acetyl hexapeptide-8</span></a>
      <a href="/products/ghk-cu/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">GHK-Cu</span><span class="text-gray-500 text-xs">Copper tripeptide</span></a>
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Category</span><span class="text-gray-500 text-xs">All cosmetic peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. Leuphasyl is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source Leuphasyl?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/cosmetic-skin/" class="text-accent-dark font-medium hover:underline">← Back to Cosmetic &amp; Skin</a></div>

</PageLayout>
