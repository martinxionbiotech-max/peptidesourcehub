---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "PEG-MGF Wholesale — Research-Grade PEGylated Mechano Growth Factor Peptide",
  "description": "Factory-direct PEG-MGF wholesale. MW ~11,500 Da. ≥99% HPLC. PEGylated IGF-1Ec — satellite cell activation. COA included.",
  "sku": "PSH-PEGMGF-1MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","— (IGF-1Ec splice variant, PEGylated)"],
  ["Sequence","IGF-1Ec E-domain peptide (24-aa insert), PEGylated"],
  ["Amino Acids","~94 + PEG moiety"],
  ["Molecular Weight","~11,500 Da (PEG-protein conjugate)"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","1 mg × 10 vials","Satellite cell research; evaluation"],
  ["Bulk Kit","2 mg × 10 vials","Muscle regeneration protocols; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label"]
];

const focusAreas = [
  ["Satellite Cell Activation","Muscle stem cell proliferation and differentiation"],
  ["Muscle Regeneration","Post-damage myofiber repair and hypertrophy models"],
  ["Sarcopenia Research","Age-related muscle stem cell depletion countermeasures"],
  ["Exercise Recovery","Mechanical load-induced MGF expression simulation"]
];

const mechanisms = [
  ["IGF-1Ec Signaling","E-domain peptide binds distinct receptor from IGF-1 → satellite cell-specific activation"],
  ["PEG Conjugation","Polyethylene glycol chain extends half-life from minutes to ~24 hours"],
  ["Myoblast Proliferation","Satellite cell → myoblast → myotube fusion → new myofiber nuclei"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","MALDI-TOF MS","~11,500 ± 500 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["PEGylation","SDS-PAGE","Band shift confirmed"],
  ["Endotoxin","LAL assay","≤0.5 EU/mg"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is Mechano Growth Factor (MGF)?", "acceptedAnswer": { "@type": "Answer", "text": "MGF is the IGF-1Ec splice variant expressed locally in skeletal muscle following mechanical load or damage. It contains a 24-amino acid E-domain that targets muscle satellite cells specifically. The 'mechano' prefix refers to its induction by mechanical stress." } },
    { "@type": "Question", "name": "Why is PEGylation necessary for MGF?", "acceptedAnswer": { "@type": "Answer", "text": "Native MGF has a very short half-life (minutes). PEGylation increases hydrodynamic radius, reduces renal clearance, and extends half-life to ~24 hours. Without PEGylation, MGF would not be viable for most research protocols." } },
    { "@type": "Question", "name": "How does MGF differ from standard IGF-1?", "acceptedAnswer": { "@type": "Answer", "text": "(1) MGF is a local splice variant expressed in muscle, not liver-derived; (2) the E-domain insert confers satellite cell receptor specificity; (3) MGF's primary role is stem cell activation/myoblast proliferation, while systemic IGF-1 primarily drives protein synthesis in mature myofibers." } },
    { "@type": "Question", "name": "What research applications use PEG-MGF?", "acceptedAnswer": { "@type": "Answer", "text": "Satellite cell (muscle stem cell) biology, muscle regeneration/repair following injury models, sarcopenia research, and exercise physiology studies exploring the MGF response to mechanical loading." } },
    { "@type": "Question", "name": "What QC is unique to PEG-MGF?", "acceptedAnswer": { "@type": "Answer", "text": "Beyond standard HPLC and MS: SDS-PAGE confirms PEGylation band shift; LAL endotoxin testing; NMR or colorimetric PEG verification. All in batch-specific COA." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Muscle Growth", "item": "https://peptidesourcehub.com/products/muscle-growth/" },
    { "@type": "ListItem", "position": 4, "name": "PEG-MGF" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="PEG-MGF Wholesale — Research-Grade PEGylated Mechano Growth Factor Peptide"
  description="Factory-direct PEG-MGF wholesale. MW ~11,500 Da. ≥99% HPLC. PEGylated IGF-1Ec — satellite cell activation. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/muscle-growth/" class="text-gray-400 hover:text-white">Muscle Growth</a><span class="text-gray-600">/</span>
      <span class="text-accent">PEG-MGF</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">PEG-MGF Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">PEGylated IGF-1Ec splice variant — muscle stem cell (satellite cell) activation research, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">PEG-MGF (PEGylated Mechano Growth Factor) is a modified form of IGF-1Ec — the splice variant of IGF-1 preferentially expressed in skeletal muscle in response to mechanical load. MGF differs from systemic IGF-1 by a 24-amino acid C-terminal E-domain insert that confers distinct receptor binding and specifically activates muscle satellite (stem) cells. PEGylation extends the peptide's half-life from minutes to ~24 hours, making it viable for chronic muscle regeneration research.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is Mechano Growth Factor (MGF)?</summary><p class="mt-3 text-gray-600 text-sm">MGF is the IGF-1Ec splice variant expressed locally in skeletal muscle following mechanical load or damage. It contains a 24-amino acid E-domain that targets muscle satellite cells specifically. The 'mechano' prefix refers to its induction by mechanical stress.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Why is PEGylation necessary for MGF?</summary><p class="mt-3 text-gray-600 text-sm">Native MGF has a very short half-life (minutes). PEGylation increases hydrodynamic radius, reduces renal clearance, and extends half-life to ~24 hours. Without PEGylation, MGF would not be viable for most research protocols.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does MGF differ from standard IGF-1?</summary><p class="mt-3 text-gray-600 text-sm">(1) MGF is a local splice variant expressed in muscle, not liver-derived; (2) the E-domain insert confers satellite cell receptor specificity; (3) MGF's primary role is stem cell activation/myoblast proliferation, while systemic IGF-1 primarily drives protein synthesis in mature myofibers.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What research applications use PEG-MGF?</summary><p class="mt-3 text-gray-600 text-sm">Satellite cell (muscle stem cell) biology, muscle regeneration/repair following injury models, sarcopenia research, and exercise physiology studies exploring the MGF response to mechanical loading.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What QC is unique to PEG-MGF?</summary><p class="mt-3 text-gray-600 text-sm">Beyond standard HPLC and MS: SDS-PAGE confirms PEGylation band shift; LAL endotoxin testing; NMR or colorimetric PEG verification. All in batch-specific COA.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/hgh/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">HGH</span><span class="text-gray-500 text-xs">Growth hormone</span></a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">CJC-1295 (DAC)</span><span class="text-gray-500 text-xs">Sustained GHRH</span></a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Ipamorelin</span><span class="text-gray-500 text-xs">Selective GHS-R agonist</span></a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Muscle Category</span><span class="text-gray-500 text-xs">All GH/IGF peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. PEG-MGF is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source PEG-MGF?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/muscle-growth/" class="text-accent-dark font-medium hover:underline">← Back to Muscle Growth</a></div>

</PageLayout>
