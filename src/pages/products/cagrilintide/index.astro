---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "sku": "PSH-CAGRI-5MG",
  "name": "Cagrilintide Wholesale — Research-Grade Amylin Analogue ≥99% Purity Bulk",
  "description": "Factory-direct Cagrilintide wholesale. CAS 2489551-48-6, ~4543 Da. ≥99% HPLC, lyophilized powder, 10-vial kits. Long-acting amylin analogue for dual-pathway metabolic research.",
  "image": "https://peptidesourcehub.com/images/products/cagrilintide.jpg",
  "category": "Metabolic Research Peptides",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "offerCount": "4",
    "highPrice": "Contact",
    "lowPrice": "Contact",
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How does Cagrilintide complement GLP-1 receptor agonists?", "acceptedAnswer": { "@type": "Answer", "text": "Cagrilintide targets the amylin pathway (AMY-R) via the area postrema, producing distinct effects: delayed gastric emptying, reduced postprandial glucagon, and central appetite modulation. GLP-1 agonists target GLP-1R in the hypothalamus and GI tract. Together, they engage two independent satiety and nutrient-processing pathways. This dual-pathway rationale is the basis for clinical interest in amylin/GLP-1 co-agonism." } },
    { "@type": "Question", "name": "What are the recommended storage conditions for Cagrilintide?", "acceptedAnswer": { "@type": "Answer", "text": "Store lyophilized powder at 2–8°C, protected from light and moisture. Under these conditions, stability is maintained for the shelf-life period indicated in the COA. After reconstitution, solution stability is protocol-dependent; use within the timeframe validated by your laboratory protocol." } },
    { "@type": "Question", "name": "Do you offer Cagrilintide in combination vials with GLP-1 peptides?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We manufacture custom fixed-dose combination kits — for example, Cagrilintide 5mg + Semaglutide 5mg in a single vial. Minimum order quantities apply for custom formulations. This pre-formulated stack simplifies laboratory workflows and ensures batch-to-batch consistency across molecules." } },
    { "@type": "Question", "name": "How does Cagrilintide compare to other amylin analogues?", "acceptedAnswer": { "@type": "Answer", "text": "Cagrilintide is a long-acting acylated amylin analogue engineered for extended half-life via fatty acid acylation (similar to the semaglutide platform). Compared to native amylin or pramlintide, its structural modifications confer significantly longer residence time, reducing dosing frequency in research protocols. This makes it particularly well-suited for combination protocols with once-weekly GLP-1 agonists." } },
  ],
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Metabolic Research", "item": "https://peptidesourcehub.com/products/metabolic/" },
    { "@type": "ListItem", "position": 4, "name": "Cagrilintide" },
  ],
};

const allJsonLd = [jsonLd, faqJsonLd, breadcrumbLd];
