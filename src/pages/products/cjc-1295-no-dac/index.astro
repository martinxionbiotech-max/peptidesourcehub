---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CJC-1295 (no DAC) Wholesale — Short-Acting GHRH Analogue Peptide",
  "description": "Factory-direct CJC-1295 without DAC wholesale. CAS 863288-34-0, ~3,367.1 Da. ≥99% HPLC. Short-acting GHRH analogue. COA included.",
  "sku": "PSH-CJC1295-2MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","863288-34-0"],
  ["Sequence","Tyr-D-Ala-Asp-Ala-Ile-Phe-Thr-Gln-Ser-Tyr-Arg-Lys-Val-Leu-Ala-Gln-Leu-Ser-Ala-Arg-Lys-Leu-Leu-Gln-Asp-Ile-Leu-Ser-Arg-Lys-NH₂"],
  ["Amino Acids","30 (no DAC linker)"],
  ["Molecular Formula","C₁₅₂H₂₅₂N₄₄O₄₂"],
  ["Molecular Weight","~3,367.1 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile or bacteriostatic water"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","2 mg × 10 vials","Pulsatile GH research; evaluation"],
  ["Bulk Kit","5 mg × 10 vials","Chronic pulse protocols; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label"]
];

const focusAreas = [
  ["Pulsatile GH","Physiological GH pulse pattern — short-duration GHRH-R activation"],
  ["Post-Exercise GH","Pulse timing relative to exercise-induced GH window"],
  ["Combination Protocols","Paired with GHS-R agonist (Ipamorelin/GHRP-2) for synergistic pulse"],
  ["GH Axis Research","Endogenous pulsatile secretion pattern studies"]
];

const mechanisms = [
  ["GHRH-R Agonism","Full receptor activation → cAMP → GH synthesis and release from somatotrophs"],
  ["Short Half-Life","~30 minute plasma half-life → discrete GH pulse → mimics endogenous GHRH"],
  ["No Albumin Binding","Absence of DAC linker → no serum albumin conjugation → renal clearance at normal rate"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~3,367.1 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["No DAC Confirmation","HPLC-MS","Absence of maleimidopropionyl mass adduct"]
];

const pricing = [
  ["1 kit","List price","Evaluation; protocol validation"],
  ["2–5 kits","10–20% off","Small groups; initial stocking"],
  ["6–20 kits","25–40% off","Mid-size distributors"],
  ["21–50 kits","40–55% off","Regional distributors; OEM pilot"],
  ["50+ kits","55–70% off","Large distributors; recurring supply"]
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "Why choose CJC-1295 without DAC?", "acceptedAnswer": { "@type": "Answer", "text": "Choice depends on research objective. No DAC = ~30 min half-life = discrete physiological GH pulse. With DAC = ~8 day half-life = sustained GH/IGF-1 elevation. Use no DAC for pulsatile GH studies; use DAC for chronic activation." } },
    { "@type": "Question", "name": "Is CJC-1295 (no DAC) the same as Mod GRF 1-29?", "acceptedAnswer": { "@type": "Answer", "text": "Essentially yes. Both refer to the same 30-amino acid GHRH analogue with four substitutions but without the DAC linker. Both terms describe the short-acting, non-albumin-binding variant." } },
    { "@type": "Question", "name": "What is the optimal partner peptide?", "acceptedAnswer": { "@type": "Answer", "text": "Ipamorelin is preferred for pulsatile protocols: CJC-1295 provides GHRH signal, Ipamorelin suppresses somatostatin tone → synergistic, clean GH pulse. GHRP-2 can be used when maximum pulse amplitude is preferred over selectivity." } },
    { "@type": "Question", "name": "What is the half-life difference vs DAC variant?", "acceptedAnswer": { "@type": "Answer", "text": "No DAC: ~30 minutes → discrete GH pulse. With DAC: ~8 days (via albumin conjugation). This ~400-fold difference is entirely due to the maleimidopropionyl DAC linker." } },
    { "@type": "Question", "name": "How is absence of DAC verified?", "acceptedAnswer": { "@type": "Answer", "text": "HPLC-MS confirms the molecular ion without the maleimidopropionyl mass adduct (+97 Da absent vs DAC variant). Included in every batch-specific COA." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Muscle Growth", "item": "https://peptidesourcehub.com/products/muscle-growth/" },
    { "@type": "ListItem", "position": 4, "name": "CJC-1295 (no DAC)" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
