---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "BPC-157 Wholesale — Research-Grade Pentadecapeptide",
  "description": "BPC-157 lyophilized powder. CAS 137525-51-0, ~1419.5 Da. ≥99% HPLC purity. 5mg or 10mg ×10 vials/kit. COA included. Bulk pricing 10–70% off.",
  "sku": "PSH-BPC157-5MG",
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","137525-51-0"],
  ["Sequence","H-Gly-Glu-Pro-Pro-Pro-Gly-Lys-Pro-Ala-Asp-Asp-Ala-Gly-Leu-Val-OH"],
  ["Amino Acids","15 (pentadecapeptide)"],
  ["Molecular Formula","C₆₂H₉₈N₁₆O₂₂"],
  ["Molecular Weight","~1419.5 Da (monoisotopic ~1418.7 Da)"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"],
];

const configs = [
  ["Standard Kit","5 mg × 10 vials","Protocol validation; evaluation orders"],
  ["Bulk Kit","10 mg × 10 vials","High-throughput research; repeat buyers"],
  ["Custom","Custom mg × custom vials","OEM; private-label; protocol-specific"],
];

const focusAreas = [
  ["Tendon Healing","Accelerated Achilles tendon repair; improved biomechanical properties"],
  ["Ligament Repair","Enhanced MCL healing; improved collagen fiber organization"],
  ["Muscle Injury","Faster crush-injury recovery; reduced fibrosis"],
  ["Bone Healing","Promoted callus formation in rabbit fracture models"],
  ["GI Protection","NSAID-induced gastric lesion protection; anastomosis healing"],
  ["Angiogenesis","VEGF upregulation; capillary formation promotion"],
  ["CNS Injury","Neuroprotective effects in TBI and spinal cord injury models"],
];

const mechanisms = [
  ["VEGF Upregulation","Increases vascular endothelial growth factor → angiogenesis at injury sites"],
  ["GH Receptor Modulation","Upregulates GH receptors on injured tissue → amplifies local GH response"],
  ["Nitric Oxide System","Modulates NO synthesis → vasodilation and tissue perfusion"],
  ["FAK-Paxillin Pathway","Activates focal adhesion kinase → fibroblast migration into wound beds"],
  ["Anti-Inflammatory","Reduces TNF-α, IL-1β; promotes M2 macrophage polarization"],
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~1419.5 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"],
  ["Solubility","Sterile water test","Clear to slightly hazy solution"],
];

const pricing = [
  ["1 kit","List price","Evaluation; protocol validation"],
  ["2–5 kits","10–20% off","Small groups; initial stocking"],
  ["6–20 kits","25–40% off","Mid-size distributors"],
  ["21–50 kits","40–55% off","Regional distributors; OEM pilot"],
  ["50+ kits","55–70% off","Large distributors; recurring supply"],
];
---

<PageLayout
  title="BPC-157 Wholesale — Research-Grade ≥99% Purity Bulk Peptide"
  description="Factory-direct BPC-157 wholesale. CAS 137525-51-0, ~1419.5 Da. ≥99% HPLC, lyophilized powder, 10-vial kits. Bulk pricing 10–70% off. COA included."
  {jsonLd}
>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/healing-recovery/" class="text-gray-400 hover:text-white">Healing & Recovery</a><span class="text-gray-600">/</span>
      <span class="text-accent">BPC-157</span>
    </nav>
    <img src="/images/products/bpc-157-bottle.png" alt="BPC-157 5mg research peptide" class="w-32 h-32 object-cover rounded-2xl border-2 border-accent/30 shadow-lg float-right ml-4 mb-4 hidden sm:block" loading="lazy" />
    <h1 class="text-white text-3xl md:text-5xl">BPC-157 Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Body Protection Compound-157 — research-grade gastric pentadecapeptide, batch-documented, manufacturer-direct</p>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">BPC-157 is a partial sequence of BPC (Body Protection Compound) isolated from human gastric juice. The 15-amino acid pentadecapeptide retains the gastroprotective and healing-promoting properties of the full protein, making it one of the most extensively studied healing peptides in preclinical research.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Is BPC-157 stable in solution after reconstitution?</summary><p class="mt-3 text-gray-600 text-sm">Relatively stable in sterile water or PBS at 4°C for 1–2 weeks, but pH-dependent. Best practice: reconstitute in sterile water/PBS (pH 7.0–7.4), aliquot single-use portions, freeze at -20°C. Avoid freeze-thaw cycles. Lyophilized powder is significantly more stable than solution.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the recommended solvent for reconstitution?</summary><p class="mt-3 text-gray-600 text-sm">Sterile water for injection or phosphate-buffered saline (PBS, pH 7.4). BPC-157 is freely soluble in aqueous buffers at neutral pH. Avoid strongly acidic/basic solvents (catalyze hydrolysis). Do not use DMSO — it can interfere with bioassays.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Do you offer BPC-157 + TB-500 as a single-vial stack?</summary><p class="mt-3 text-gray-600 text-sm">Yes — one of our most popular pre-formulated stacks. Our R&D team has validated chemical compatibility in a single lyophilized vial. Ships with combined COA covering both peptides. See <a href="/products/specialty-stacks/" class="text-accent-dark hover:underline">Specialty Stacks</a> or <a href="/contact/" class="text-accent-dark hover:underline">contact us</a> for a quote.</p></details>
    </div>
  </div>
</section>

<!-- Cross-sell -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/tb-500/" class="card p-4 text-center hover:border-accent/30 transition-colors">
        <span class="font-semibold text-primary block">TB-500</span><span class="text-gray-500 text-xs">Cell migration & remodeling</span>
      </a>
      <a href="/products/ghk-cu/" class="card p-4 text-center hover:border-accent/30 transition-colors">
        <span class="font-semibold text-primary block">GHK-Cu</span><span class="text-gray-500 text-xs">Collagen & angiogenesis</span>
      </a>
      <a href="/products/muscle-growth/" class="card p-4 text-center hover:border-accent/30 transition-colors">
        <span class="font-semibold text-primary block">CJC-1295</span><span class="text-gray-500 text-xs">GH axis support</span>
      </a>
      <a href="/products/healing-recovery/" class="card p-4 text-center hover:border-accent/30 transition-colors">
        <span class="font-semibold text-primary block">ARA-290</span><span class="text-gray-500 text-xs">Tissue protection</span>
      </a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. BPC-157 is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source BPC-157?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/healing-recovery/" class="text-accent-dark font-medium hover:underline">← Back to Healing & Recovery</a></div>
</PageLayout>
