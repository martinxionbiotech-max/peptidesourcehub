<a href="/products/cagrilintide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Cagrilintide</span><span class="text-gray-500 text-xs">Amylin analogue</span></a>
<a href="/products/metabolic/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">AOD-9604</span><span class="text-gray-500 text-xs">Lipolytic hGH</span></a>
<a href="/products/specialty-stacks/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Cag/Sema Stack</span><span class="text-gray-500 text-xs">Dual-pathway</span></a>
</div></div></section>

<section class="section bg-white"><div class="container-narrow mx-auto px-4 text-center"><p class="text-gray-500 text-sm max-w-2xl mx-auto"><strong>FOR LABORATORY RESEARCH USE ONLY.</strong> Not for human or veterinary diagnostic, therapeutic, prophylactic, or any clinical use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p></div></section>

<section class="section bg-primary py-16 text-center"><div class="container-wide mx-auto px-4"><h2 class="text-white text-3xl mb-4">Ready to Source Semaglutide?</h2><p class="text-gray-300 max-w-xl mx-auto mb-8">Volume leader for metabolic portfolios. Tiered pricing up to 70% off. Custom annual contracts available.</p><div class="flex justify-center gap-4 flex-wrap"><a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a></div></div></section>

<div class="text-center py-6 bg-surface"><a href="/products/metabolic/" class="text-accent-dark font-medium hover:underline">← Back to Metabolic</a></div>
