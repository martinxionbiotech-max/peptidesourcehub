---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Selank Wholesale — Research-Grade Tuftsin-Derived Anxiolytic Nootropic Peptide",
  "description": "Factory-direct Selank wholesale. CAS 129954-34-1, ~751.9 Da. ≥99% HPLC. Tuftsin analogue — anxiolytic without sedation. COA included.",
  "sku": "PSH-SELANK-10MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","129954-34-1"],
  ["Sequence","Thr-Lys-Pro-Arg-Pro-Gly-Pro-OH"],
  ["Amino Acids","7 (tuftsin analogue + Pro-Gly-Pro)"],
  ["Molecular Formula","C₃₃H₅₇N₁₁O₉"],
  ["Molecular Weight","~751.9 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","10 mg × 10 vials","Anxiolytic research; evaluation"],
  ["Bulk Kit","30 mg × 10 vials","Chronic anxiety models; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label"]
];

const focusAreas = [
  ["Anxiolysis","GABAergic modulation — anxiety reduction without sedation in models"],
  ["Cognitive Function","Learning & memory preservation under stress conditions"],
  ["Immune-Neural Bridge","Tuftsin-derived immunomodulation → CNS effects"],
  ["Stress Resilience","HPA axis modulation; cortisol reduction in stress models"],
  ["Antiviral Research","Tuftsin-mediated immune enhancement against viral challenges"]
];

const mechanisms = [
  ["GABAergic Modulation","Positive modulation of GABA-A receptor function → anxiolysis without sedation"],
  ["Dopaminergic System","Modulation of dopamine turnover → cognitive preservation under stress"],
  ["Immune Modulation","Tuftsin-derived Thr-Lys-Pro-Arg motif → macrophage/neutrophil activation"],
  ["C-terminal PGP","Pro-Gly-Pro extension → enhanced stability and BBB penetration (shared with Semax)"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~751.9 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; protocol validation"],
  ["2–5 kits","10–20% off","Small groups; initial stocking"],
  ["6–20 kits","25–40% off","Mid-size distributors"],
  ["21–50 kits","40–55% off","Regional distributors; OEM pilot"],
  ["50+ kits","55–70% off","Large distributors; recurring supply"]
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "How does Selank compare to benzodiazepines?", "acceptedAnswer": { "@type": "Answer", "text": "Selank produces anxiolytic effects through GABAergic modulation without sedation, amnesia, tolerance, or withdrawal. Rather than directly agonizing GABA-A, Selank modulates endogenous GABA tone — a more subtle mechanism preserving cognitive function and alertness." } },
    { "@type": "Question", "name": "What is the connection between tuftsin and Selank?", "acceptedAnswer": { "@type": "Answer", "text": "Tuftsin (Thr-Lys-Pro-Arg) is a natural splenic tetrapeptide that activates macrophages. Selank adds Pro-Gly-Pro to tuftsin, creating dual functionality: immunomodulation + CNS delivery. This immune-neural bridge is a defining feature of Selank's pharmacology." } },
    { "@type": "Question", "name": "How does Selank differ from Semax?", "acceptedAnswer": { "@type": "Answer", "text": "Both are PGP-extended heptapeptides but from different parents. Semax (ACTH-derived) → melanocortin → BDNF/NGF → cognition. Selank (tuftsin-derived) → GABA/dopamine → anxiolysis. Complementary: Semax for cognition, Selank for anxiety." } },
    { "@type": "Question", "name": "Does Selank cause sedation?", "acceptedAnswer": { "@type": "Answer", "text": "No — a significant distinction from benzodiazepines. In animal models, Selank produces anxiolytic effects at doses that do not cause sedation, motor impairment, or amnesia. Attributed to modulation of endogenous GABA tone rather than direct receptor agonism." } },
    { "@type": "Question", "name": "What purity and QC is provided?", "acceptedAnswer": { "@type": "Answer", "text": "≥99% HPLC purity, ESI-MS identity, amino acid analysis. Pro-Gly-Pro extension verified by MS/MS fragmentation. Batch-specific COA included." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Nootropic &amp; Anti-Aging", "item": "https://peptidesourcehub.com/products/nootropic-anti-aging/" },
    { "@type": "ListItem", "position": 4, "name": "Selank" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="Selank Wholesale — Research-Grade Tuftsin-Derived Anxiolytic Nootropic Peptide"
  description="Factory-direct Selank wholesale. CAS 129954-34-1, ~751.9 Da. ≥99% HPLC. Tuftsin analogue — anxiolytic without sedation. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/nootropic-anti-aging/" class="text-gray-400 hover:text-white">Nootropic &amp; Anti-Aging</a><span class="text-gray-600">/</span>
      <span class="text-accent">Selank</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Selank Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Tuftsin-derived heptapeptide — GABAergic/dopaminergic anxiolytic without sedation, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">Selank is a synthetic heptapeptide sharing the same Pro-Gly-Pro C-terminal extension design as Semax. While Semax derives from ACTH, Selank derives from tuftsin (Thr-Lys-Pro-Arg) — a natural immunomodulatory tetrapeptide. The Pro-Gly-Pro tail transforms tuftsin from a pure immune peptide into a dual-function molecule engaging the immune-neural interface while enabling CNS penetration. Selank's primary research application is anxiolysis through GABAergic and dopaminergic modulation — producing anxiety reduction without sedation, cognitive impairment, or dependence liability.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Selank compare to benzodiazepines?</summary><p class="mt-3 text-gray-600 text-sm">Selank produces anxiolytic effects through GABAergic modulation without sedation, amnesia, tolerance, or withdrawal. Rather than directly agonizing GABA-A, Selank modulates endogenous GABA tone — a more subtle mechanism preserving cognitive function and alertness.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the connection between tuftsin and Selank?</summary><p class="mt-3 text-gray-600 text-sm">Tuftsin (Thr-Lys-Pro-Arg) is a natural splenic tetrapeptide that activates macrophages. Selank adds Pro-Gly-Pro to tuftsin, creating dual functionality: immunomodulation + CNS delivery. This immune-neural bridge is a defining feature of Selank's pharmacology.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Selank differ from Semax?</summary><p class="mt-3 text-gray-600 text-sm">Both are PGP-extended heptapeptides but from different parents. Semax (ACTH-derived) → melanocortin → BDNF/NGF → cognition. Selank (tuftsin-derived) → GABA/dopamine → anxiolysis. Complementary: Semax for cognition, Selank for anxiety.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Does Selank cause sedation?</summary><p class="mt-3 text-gray-600 text-sm">No — a significant distinction from benzodiazepines. In animal models, Selank produces anxiolytic effects at doses that do not cause sedation, motor impairment, or amnesia. Attributed to modulation of endogenous GABA tone rather than direct receptor agonism.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What purity and QC is provided?</summary><p class="mt-3 text-gray-600 text-sm">≥99% HPLC purity, ESI-MS identity, amino acid analysis. Pro-Gly-Pro extension verified by MS/MS fragmentation. Batch-specific COA included.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Semax</span><span class="text-gray-500 text-xs">ACTH-derived nootropic</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Epithalon</span><span class="text-gray-500 text-xs">Telomerase activator</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">DSIP</span><span class="text-gray-500 text-xs">Sleep architecture peptide</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Nootropic Category</span><span class="text-gray-500 text-xs">All cognitive peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. Selank is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source Selank?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/nootropic-anti-aging/" class="text-accent-dark font-medium hover:underline">← Back to Nootropic &amp; Anti-Aging</a></div>

</PageLayout>
