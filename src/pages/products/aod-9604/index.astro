---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "AOD-9604 Wholesale — Research-Grade hGH Fragment 177-191 Lipolytic Peptide",
  "description": "Factory-direct AOD-9604 wholesale. CAS 221231-10-3, ~1,815.1 Da. ≥99% HPLC. hGH fragment 177-191 — selective adipose lipolysis. COA included.",
  "sku": "PSH-AOD-2MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","221231-10-3"],
  ["Sequence","H-YLRIVQCRSVEGSCGF-OH (cyclic, Cys⁷–Cys¹⁴ disulfide)"],
  ["Amino Acids","16 (cyclic via disulfide bond)"],
  ["Molecular Formula","C₇₈H₁₂₃N₂₃O₂₃S₂"],
  ["Molecular Weight","~1,815.1 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","2 mg × 10 vials","Lipolysis models; evaluation orders"],
  ["Bulk Kit","5 mg × 10 vials","Chronic metabolic models; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label; protocol-specific"]
];

const focusAreas = [
  ["Adipose Lipolysis","Selective fat mobilization via β3-adrenergic pathway without IGF-1 elevation"],
  ["Cartilage Repair","Chondrocyte proliferation & proteoglycan synthesis in osteoarthritis models"],
  ["Metabolic Research","Fat oxidation during caloric deficit; glucose homeostasis preservation"],
  ["Body Composition","Fat mass reduction without lean mass loss in rodent models"]
];

const mechanisms = [
  ["β3-Adrenergic Receptor","Agonism at β3-AR on adipocytes → cAMP → hormone-sensitive lipase activation"],
  ["No GH Receptor Binding","Fragment lacks amino acids 1–176 required for GHR binding → no IGF-1 induction"],
  ["Chondrogenesis","Independent chondrocyte proliferation pathway — not mediated through GH/IGF-1 axis"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~1,815.1 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Disulfide Bond","Ellman's test","Confirmed cyclic (Cys⁷–Cys¹⁴)"],
  ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is AOD-9604 and how does it relate to HGH?", "acceptedAnswer": { "@type": "Answer", "text": "AOD-9604 is the synthetic C-terminal fragment (amino acids 177-191) of human Growth Hormone. It retains the lipolytic domain of hGH without the GHR binding region — meaning it stimulates fat breakdown without raising IGF-1 levels." } },
    { "@type": "Question", "name": "Does AOD-9604 affect blood glucose like full HGH?", "acceptedAnswer": { "@type": "Answer", "text": "No. Unlike full-length hGH (which can induce insulin resistance via its diabetogenic domain), the 177-191 fragment does not impair glucose tolerance. The diabetogenic domain of hGH resides outside the 177-191 sequence." } },
    { "@type": "Question", "name": "What is the role of the disulfide bond in AOD-9604?", "acceptedAnswer": { "@type": "Answer", "text": "The Cys⁷–Cys¹⁴ disulfide bond is essential for the cyclic structure and biological activity. It constrains the peptide into the conformation required for β3-adrenergic receptor interaction. Verified by Ellman's test in every batch." } },
    { "@type": "Question", "name": "What purity specification applies to AOD-9604?", "acceptedAnswer": { "@type": "Answer", "text": "≥99% by HPLC at 214 nm with ESI-MS identity confirmation and Ellman's test for disulfide verification. Batch-specific COA included." } },
    { "@type": "Question", "name": "What is the difference between AOD-9604 and full-length HGH?", "acceptedAnswer": { "@type": "Answer", "text": "HGH (191 amino acids, ~22,125 Da) activates all GH receptor pathways including IGF-1 elevation and insulin resistance. AOD-9604 (16 amino acids, ~1,815 Da) is a precision fragment targeting only the lipolytic domain." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Metabolic Research", "item": "https://peptidesourcehub.net/products/metabolic/" },
    { "@type": "ListItem", "position": 4, "name": "AOD-9604" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="AOD-9604 | Buy Wholesale"
  description="Factory-direct AOD-9604 wholesale. CAS 221231-10-3, ~1,815.1 Da. ≥99% HPLC. hGH fragment 177-191 — selective adipose lipolysis. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/metabolic/" class="text-gray-400 hover:text-white">Metabolic Research</a><span class="text-gray-600">/</span>
      <span class="text-accent">AOD-9604</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">AOD-9604 Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">hGH C-terminal fragment 177–191 — selective lipolytic peptide without IGF-1 elevation, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">AOD-9604 is the synthetic C-terminal fragment of human Growth Hormone, spanning amino acids 177 through 191. This 16-amino acid cyclic peptide retains the lipolytic domain of hGH while lacking the N-terminal region required for Growth Hormone Receptor (GHR) binding and subsequent IGF-1 induction. The result is a precision tool for studying adipose tissue lipolysis without the confounding effects of the GH/IGF-1 axis — including insulin resistance, IGF-1 elevation, and growth-promoting activity.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is AOD-9604 and how does it relate to HGH?</summary><p class="mt-3 text-gray-600 text-sm">AOD-9604 is the synthetic C-terminal fragment (amino acids 177-191) of human Growth Hormone. It retains the lipolytic domain of hGH without the GHR binding region — meaning it stimulates fat breakdown without raising IGF-1 levels.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Does AOD-9604 affect blood glucose like full HGH?</summary><p class="mt-3 text-gray-600 text-sm">No. Unlike full-length hGH (which can induce insulin resistance via its diabetogenic domain), the 177-191 fragment does not impair glucose tolerance. The diabetogenic domain of hGH resides outside the 177-191 sequence.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the role of the disulfide bond in AOD-9604?</summary><p class="mt-3 text-gray-600 text-sm">The Cys⁷–Cys¹⁴ disulfide bond is essential for the cyclic structure and biological activity. It constrains the peptide into the conformation required for β3-adrenergic receptor interaction. Verified by Ellman's test in every batch.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What purity specification applies to AOD-9604?</summary><p class="mt-3 text-gray-600 text-sm">≥99% by HPLC at 214 nm with ESI-MS identity confirmation and Ellman's test for disulfide verification. Batch-specific COA included.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the difference between AOD-9604 and full-length HGH?</summary><p class="mt-3 text-gray-600 text-sm">HGH (191 amino acids, ~22,125 Da) activates all GH receptor pathways including IGF-1 elevation and insulin resistance. AOD-9604 (16 amino acids, ~1,815 Da) is a precision fragment targeting only the lipolytic domain.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/hgh/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">HGH</span><span class="text-gray-500 text-xs">Full growth hormone</span></a>
      <a href="/products/semaglutide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Semaglutide</span><span class="text-gray-500 text-xs">GLP-1R agonist</span></a>
      <a href="/products/tirzepatide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Tirzepatide</span><span class="text-gray-500 text-xs">Dual GIP/GLP-1</span></a>
      <a href="/products/metabolic/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Metabolic Category</span><span class="text-gray-500 text-xs">All metabolic peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. AOD-9604 is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source AOD-9604?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/metabolic/" class="text-accent-dark font-medium hover:underline">← Back to Metabolic Research</a></div>

</PageLayout>
