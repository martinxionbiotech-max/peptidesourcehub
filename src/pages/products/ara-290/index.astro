---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "ARA-290 Wholesale — Research-Grade Erythropoietin-Derived Tissue Protective Peptide",
  "description": "Factory-direct ARA-290 wholesale. CAS 1208243-50-8, ~1,258.4 Da. ≥99% HPLC. Innate Repair Receptor agonist — tissue protection. COA included.",
  "sku": "PSH-ARA290-5MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
    ["CAS Number","1208243-50-8"],
    ["Sequence","H-Gln-Glu-Gln-Leu-Glu-Arg-Ala-Leu-Asn-Ser-Ser-OH"],
    ["Amino Acids","11"],
    ["Molecular Formula","C₅₁H₈₄N₁₆O₁₉"],
    ["Molecular Weight","~1,258.4 Da"],
    ["Appearance","White to off-white lyophilized powder"],
    ["Purity","≥99% by HPLC"],
    ["Solubility","Soluble in sterile water or PBS"],
    ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
    ["Standard Kit","5 mg × 10 vials","Tissue protection models; evaluation"],
    ["Bulk Kit","10 mg × 10 vials","Chronic neuropathy models; repeat orders"],
    ["Custom","Custom mg × custom vials","OEM; private-label; protocol-specific"]
];

const focusAreas = [
    ["Small Fiber Neuropathy","Nerve fiber density preservation; pain threshold normalization"],
    ["Cardiac Ischemia-Reperfusion","Infarct size reduction; caspase-3 suppression"],
    ["Wound Healing","Chronic wound models; diabetic ulcer re-epithelialization"],
    ["Renal Protection","Acute kidney injury models; tubular cell survival"],
    ["Neuroinflammation","Microglial activation modulation; IL-1β/TNF-α suppression"]
];

const mechanisms = [
    ["IRR Agonism","Selective Innate Repair Receptor (CD131/β-common receptor) activation → no EPO-R binding"],
    ["JAK2/STAT3 Pathway","Anti-inflammatory signaling cascade → suppression of pro-inflammatory cytokines"],
    ["Anti-Apoptotic","Bcl-2 upregulation; caspase-3 inhibition; mitochondrial membrane stabilization"],
    ["No Erythropoiesis","Engineered to avoid EPO-R homodimer → no hematocrit elevation or thrombosis risk"]
];

const qcSpecs = [
    ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
    ["Identity (MW)","ESI-MS","~1,258.4 ± 1.0 Da"],
    ["Appearance","Visual inspection","White to off-white powder"],
    ["Peptide Content","Amino acid analysis","≥80% net peptide"],
    ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is ARA-290 and how does it differ from EPO?", "acceptedAnswer": { "@type": "Answer", "text": "ARA-290 is an 11-amino acid peptide derived from the helix B domain of erythropoietin. It selectively activates the Innate Repair Receptor (IRR/CD131) without binding the classical EPO receptor — providing tissue protection without erythropoiesis (no increase in hematocrit). This receptor selectivity is the defining feature." } },
    { "@type": "Question", "name": "What research applications is ARA-290 used for?", "acceptedAnswer": { "@type": "Answer", "text": "Primarily neuroprotection (small fiber neuropathy, peripheral nerve injury models), cardiac ischemia-reperfusion injury reduction, wound healing (chronic and diabetic ulcer models), renal protection, and neuroinflammation research." } },
    { "@type": "Question", "name": "Why doesn't ARA-290 affect red blood cell production?", "acceptedAnswer": { "@type": "Answer", "text": "EPO's tissue-protective and erythropoietic activities are mediated by distinct receptor complexes. ARA-290 was specifically engineered to only activate the IRR/CD131 heterodimer (tissue protection) and not the EPO-R homodimer (erythropoiesis)." } },
    { "@type": "Question", "name": "How should ARA-290 be stored?", "acceptedAnswer": { "@type": "Answer", "text": "Lyophilized powder: 2–8°C, desiccated, 24-month stability. After reconstitution in sterile water or PBS, aliquot single-use portions and store at -20°C. Avoid freeze-thaw cycles." } },
    { "@type": "Question", "name": "What documentation is included with ARA-290?", "acceptedAnswer": { "@type": "Answer", "text": "Batch-specific COA (HPLC purity, ESI-MS identity confirmation), commercial invoice, and packing list. Full chromatogram and MS spectrum available on request." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Healing &amp; Recovery", "item": "https://peptidesourcehub.net/products/healing-recovery/" },
    { "@type": "ListItem", "position": 4, "name": "ARA-290" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="ARA-290 | Buy Wholesale"
  description="Factory-direct ARA-290 wholesale. CAS 1208243-50-8, ~1,258.4 Da. ≥99% HPLC. Innate Repair Receptor agonist — tissue protection. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/healing-recovery/" class="text-gray-400 hover:text-white">Healing &amp; Recovery</a><span class="text-gray-600">/</span>
      <span class="text-accent">ARA-290</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">ARA-290 Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Erythropoietin-derived 11-mer helix B peptide — tissue protection & repair via IRR agonism without erythropoietic effects, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">ARA-290 is an 11-amino acid peptide engineered from the helix B domain of erythropoietin (EPO). The key innovation behind ARA-290 is its receptor selectivity: it activates the Innate Repair Receptor (IRR, also known as the β-common receptor/CD131 heterodimer) but does not bind the classical EPO receptor (EPO-R). This receptor discrimination separates tissue-protective signaling from erythropoietic signaling — in research models, ARA-290 demonstrates tissue protection and anti-inflammatory effects without elevating hematocrit.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is ARA-290 and how does it differ from EPO?</summary><p class="mt-3 text-gray-600 text-sm">ARA-290 is an 11-amino acid peptide derived from the helix B domain of erythropoietin. It selectively activates the Innate Repair Receptor (IRR/CD131) without binding the classical EPO receptor — providing tissue protection without erythropoiesis (no increase in hematocrit). This receptor selectivity is the defining feature.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What research applications is ARA-290 used for?</summary><p class="mt-3 text-gray-600 text-sm">Primarily neuroprotection (small fiber neuropathy, peripheral nerve injury models), cardiac ischemia-reperfusion injury reduction, wound healing (chronic and diabetic ulcer models), renal protection, and neuroinflammation research.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Why doesn't ARA-290 affect red blood cell production?</summary><p class="mt-3 text-gray-600 text-sm">EPO's tissue-protective and erythropoietic activities are mediated by distinct receptor complexes. ARA-290 was specifically engineered to only activate the IRR/CD131 heterodimer (tissue protection) and not the EPO-R homodimer (erythropoiesis).</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How should ARA-290 be stored?</summary><p class="mt-3 text-gray-600 text-sm">Lyophilized powder: 2–8°C, desiccated, 24-month stability. After reconstitution in sterile water or PBS, aliquot single-use portions and store at -20°C. Avoid freeze-thaw cycles.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What documentation is included with ARA-290?</summary><p class="mt-3 text-gray-600 text-sm">Batch-specific COA (HPLC purity, ESI-MS identity confirmation), commercial invoice, and packing list. Full chromatogram and MS spectrum available on request.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/bpc-157/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">BPC-157</span><span class="text-gray-500 text-xs">Cytoprotective peptide</span></a>
      <a href="/products/tb-500/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">TB-500</span><span class="text-gray-500 text-xs">Actin fragment</span></a>
      <a href="/products/healing-recovery/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Healing Category</span><span class="text-gray-500 text-xs">All repair peptides</span></a>
      <a href="/products/specialty-stacks/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Recovery Stack</span><span class="text-gray-500 text-xs">Pre-formulated blend</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. ARA-290 is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source ARA-290?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/healing-recovery/" class="text-accent-dark font-medium hover:underline">← Back to Healing &amp; Recovery</a></div>

</PageLayout>
