---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Matrixyl Wholesale — Research-Grade Palmitoyl Pentapeptide-4 Collagen Signaling Peptide",
  "description": "Factory-direct Matrixyl wholesale. CAS 214047-00-4, ~803.9 Da. ≥99% HPLC. Palmitoyl pentapeptide-4 — procollagen I signaling. COA included.",
  "sku": "PSH-MATRX-10MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
    ["CAS Number","214047-00-4"],
    ["Sequence","Palmitoyl-Lys-Thr-Thr-Lys-Ser-OH"],
    ["Amino Acids","5 (N-terminal palmitoyl)"],
    ["Molecular Formula","C₃₉H₇₅N₇O₁₀"],
    ["Molecular Weight","~803.9 Da"],
    ["Appearance","White to off-white lyophilized powder"],
    ["Purity","≥99% by HPLC"],
    ["Solubility","Lipid-soluble; limited aqueous solubility"],
    ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
    ["Standard Kit","10 mg × 10 vials","ECM research; formulation evaluation"],
    ["Bulk Kit","50 mg × 10 vials","Product development; pilot batches"],
    ["Custom","Custom mg × custom vials","OEM; private-label cosmetics"]
];

const focusAreas = [
    ["Collagen Synthesis","Procollagen I and III upregulation in dermal fibroblast models"],
    ["ECM Remodeling","Fibronectin and elastin production stimulation"],
    ["Wrinkle Reduction","Dermal matrix regeneration in photoaged skin models"],
    ["Skin Firmness","Increased dermal density and elasticity in clinical research"]
];

const mechanisms = [
    ["Matrikine Signaling","Collagen fragment mimetic → activates fibroblast ECM synthesis programs"],
    ["TGF-β Pathway","Stimulates TGF-β → procollagen I/III transcription in dermal fibroblasts"],
    ["Palmitoyl Anchoring","C16 palmitoyl chain → enhanced stratum corneum partitioning and dermal delivery"]
];

const qcSpecs = [
    ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
    ["Identity (MW)","ESI-MS","~803.9 ± 1.0 Da"],
    ["Appearance","Visual inspection","White to off-white powder"],
    ["Peptide Content","Amino acid analysis","≥80% net peptide"],
    ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "How does Matrixyl differ from other cosmetic peptides?", "acceptedAnswer": { "@type": "Answer", "text": "Matrixyl targets the structural extracellular matrix (collagen, elastin, fibronectin synthesis) rather than neuromuscular signaling. While Argireline/Snap-8 reduce lines by inhibiting contraction, Matrixyl rebuilds dermal matrix components through matrikine signaling." } },
    { "@type": "Question", "name": "What is the purpose of the palmitoyl group?", "acceptedAnswer": { "@type": "Answer", "text": "N-terminal palmitoyl (C16) dramatically enhances stratum corneum penetration by partitioning into the lipid-rich intercellular matrix, and anchors the peptide at the cell membrane, prolonging fibroblast receptor interaction. Without it, dermal delivery would be negligible." } },
    { "@type": "Question", "name": "What does 'matrikine' mean?", "acceptedAnswer": { "@type": "Answer", "text": "Matrikines are peptide fragments released during ECM degradation that signal cells to initiate repair. Matrixyl mimics this by presenting a collagen-derived peptide sequence to fibroblasts — 'tricking' cells into believing ECM damage has occurred, triggering repair." } },
    { "@type": "Question", "name": "Is Matrixyl compatible with other cosmetic peptides?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Matrixyl's ECM-building mechanism is complementary to neurotransmitter-targeting peptides (Argireline, Snap-8) and copper peptides (GHK-Cu). Multi-peptide formulations combining matrikine + neurotransmitter inhibitor + carrier peptide are common research strategies." } },
    { "@type": "Question", "name": "What purity is Matrixyl supplied at?", "acceptedAnswer": { "@type": "Answer", "text": "≥99% by HPLC at 214 nm. Palmitoylation efficiency (>98%) verified by HPLC with ELSD detection. Batch-specific COA included." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Cosmetic &amp; Skin", "item": "https://peptidesourcehub.net/products/cosmetic-skin/" },
    { "@type": "ListItem", "position": 4, "name": "Matrixyl" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="Matrixyl | Buy Wholesale"
  description="Factory-direct Matrixyl wholesale. CAS 214047-00-4, ~803.9 Da. ≥99% HPLC. Palmitoyl pentapeptide-4 — procollagen I signaling. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/cosmetic-skin/" class="text-gray-400 hover:text-white">Cosmetic &amp; Skin</a><span class="text-gray-600">/</span>
      <span class="text-accent">Matrixyl</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Matrixyl Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">Palmitoyl pentapeptide-4 — collagen fragment signal peptide for extracellular matrix research, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">Matrixyl (Palmitoyl Pentapeptide-4) is a lipopeptide designed around the concept of 'matrikine' signaling — using small peptide fragments of extracellular matrix proteins to stimulate the skin's own repair mechanisms. It consists of the pentapeptide Lys-Thr-Thr-Lys-Ser conjugated to a palmitic acid (C16) chain for enhanced skin penetration. Unlike neurotransmitter-targeting peptides (Argireline, Snap-8), Matrixyl addresses expression lines from the structural side — rebuilding dermal matrix components rather than inhibiting muscle contraction.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Matrixyl differ from other cosmetic peptides?</summary><p class="mt-3 text-gray-600 text-sm">Matrixyl targets the structural extracellular matrix (collagen, elastin, fibronectin synthesis) rather than neuromuscular signaling. While Argireline/Snap-8 reduce lines by inhibiting contraction, Matrixyl rebuilds dermal matrix components through matrikine signaling.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the purpose of the palmitoyl group?</summary><p class="mt-3 text-gray-600 text-sm">N-terminal palmitoyl (C16) dramatically enhances stratum corneum penetration by partitioning into the lipid-rich intercellular matrix, and anchors the peptide at the cell membrane, prolonging fibroblast receptor interaction. Without it, dermal delivery would be negligible.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What does 'matrikine' mean?</summary><p class="mt-3 text-gray-600 text-sm">Matrikines are peptide fragments released during ECM degradation that signal cells to initiate repair. Matrixyl mimics this by presenting a collagen-derived peptide sequence to fibroblasts — 'tricking' cells into believing ECM damage has occurred, triggering repair.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Is Matrixyl compatible with other cosmetic peptides?</summary><p class="mt-3 text-gray-600 text-sm">Yes. Matrixyl's ECM-building mechanism is complementary to neurotransmitter-targeting peptides (Argireline, Snap-8) and copper peptides (GHK-Cu). Multi-peptide formulations combining matrikine + neurotransmitter inhibitor + carrier peptide are common research strategies.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What purity is Matrixyl supplied at?</summary><p class="mt-3 text-gray-600 text-sm">≥99% by HPLC at 214 nm. Palmitoylation efficiency (>98%) verified by HPLC with ELSD detection. Batch-specific COA included.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/ghk-cu/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">GHK-Cu</span><span class="text-gray-500 text-xs">Copper tripeptide</span></a>
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Snap-8</span><span class="text-gray-500 text-xs">Acetyl octapeptide-3</span></a>
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Argireline</span><span class="text-gray-500 text-xs">Acetyl hexapeptide-8</span></a>
      <a href="/products/cosmetic-skin/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Cosmetic Category</span><span class="text-gray-500 text-xs">All skin peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. Matrixyl is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source Matrixyl?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/cosmetic-skin/" class="text-accent-dark font-medium hover:underline">← Back to Cosmetic &amp; Skin</a></div>

</PageLayout>
