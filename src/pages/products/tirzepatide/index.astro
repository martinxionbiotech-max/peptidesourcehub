---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Tirzepatide Wholesale — Dual GIP/GLP-1 Agonist",
  "description": "Tirzepatide lyophilized powder. CAS 2023788-19-2, ~4813.5 Da. ≥99% HPLC purity. 39-amino acid dual GIP/GLP-1 receptor agonist. COA included. Tiered wholesale pricing.",
  "sku": "PSH-TIRZ-5MG",
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","2023788-19-2"],
  ["Sequence","39-amino acid with Aib²+Aib¹³ + C20 fatty diacid linker + C-terminal amidation"],
  ["Molecular Weight","~4,813.5 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Phosphate buffer (pH 7.4) or dilute acetic acid"],
  ["Storage","2–8°C, desiccated, protect from light"],
];

const configs = [
  ["Standard Kit","5 mg × 10 vials","Most protocols; evaluation"],
  ["Bulk Kit","10 mg × 10 vials","High-throughput; OEM"],
  ["Custom","Custom mg × custom vials","Private-label; protocol-specific"],
];

const features = [
  ["GIP-backbone design","Based on native GIP → greater GIPR potency (5× GIPR vs GLP-1R)"],
  ["Aib², Aib¹³","DPP-4 resistance → extended half-life"],
  ["C20 fatty diacid","Longer chain than Semaglutide's C18 → stronger albumin binding (~5-day t½)"],
  ["C-terminal Pro-rich","Pro-Pro-Pro-Ser-NH₂ → receptor selectivity optimization"],
  ["AEEA-AEEA-γ-Glu spacer","Optimal separation between peptide and albumin-binding moiety"],
];

const receptor = [
  ["Binding Affinity (Ki)","~2.3 nM","~12.6 nM"],
  ["Functional Activity (EC₅₀)","~0.06 nM (cAMP)","~0.03 nM (cAMP)"],
  ["Relative Potency","~5× more potent","Reference"],
];

const focusAreas = [
  ["Body Weight","~22.5% mean reduction (SURMOUNT-1); >GLP-1 alone"],
  ["Glycemic Control","HbA1c reduction up to 2.4%; superior to Semaglutide 1mg"],
  ["Lipid Metabolism","Improved lipid profiles; reduced triglycerides"],
  ["Insulin Sensitivity","Improved beyond weight loss alone (GIP-mediated)"],
  ["NASH/NAFLD","Reduced liver fat content; under investigation for NASH"],
];

const comparison = [
  ["Receptor","GLP-1R","GIPR + GLP-1R","GIPR + GLP-1R + GCGR"],
  ["Amino Acids","31","39","39"],
  ["MW","~4,113.6 Da","~4,813.5 Da","~4,845.5 Da"],
  ["Linker","C18","C20","C20"],
  ["BW Reduction","~15%","~22.5%","~24.2% (Ph2)"],
  ["B2B Position","Volume leader","Differentiation","Innovation"],
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~4,813.5 ± 1.5 Da"],
  ["Appearance","Visual","White to off-white powder"],
  ["Peptide Content","AAA / elemental","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"],
  ["Linker Integrity","HPLC-ELSD / LC-MS/MS","Intact C20 linker (bulk)"],
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["2–5 kits","10–20% off","Initial portfolio expansion"],
  ["6–20 kits","25–40% off","Mid-size distributors"],
  ["21–50 kits","40–55% off","Regional distributors"],
  ["50+ kits","55–70% off","Large distributors; recurring"],
];
---

<PageLayout title="Tirzepatide Wholesale — Research-Grade Dual GIP/GLP-1 ≥99% Purity Bulk" description="Factory-direct Tirzepatide wholesale. CAS 2023788-19-2, ~4813.5 Da. ≥99% HPLC, lyophilized powder. Dual GIP/GLP-1 agonist. Tiered pricing. COA." {jsonLd}>

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb"><a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span><a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span><a href="/products/metabolic/" class="text-gray-400 hover:text-white">Metabolic</a><span class="text-gray-600">/</span><span class="text-accent">Tirzepatide</span></nav>
    
    <h1 class="text-white text-3xl md:text-5xl">Tirzepatide Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">39-amino acid dual GIP/GLP-1 receptor agonist — the differentiation leader in metabolic peptide portfolios</p>
  </div>
</section>

<section class="section bg-white"><div class="container-wide mx-auto px-4"><h2 class="mb-6">Product Identity</h2>
<img src="/images/products/tirzepatide-bottle.jpg" alt="Tirzepatide 10mg research peptide vial" class="float-right ml-4 mb-2 w-36 h-36 md:w-44 md:h-44 lg:w-48 lg:h-48 object-cover rounded-2xl border-2 border-accent/30 shadow-lg hidden sm:block" loading="lazy" /><div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm"><table class="w-full text-sm bg-white"><tbody>{specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}</tbody></table></div></div></section>

<section class="section dot-pattern"><div class="container-wide mx-auto px-4"><h2 class="text-center mb-6">Configurations</h2><div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm"><table class="w-full text-sm bg-white"><thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead><tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody></table></div></div></section>

<section class="section bg-white"><div class="container-wide mx-auto px-4"><h2 class="mb-6">Research Background</h2><div class="max-w-4xl"><p class="text-gray-600 mb-6">Tirzepatide is an "imbalanced" dual agonist — it activates both GIP and GLP-1 receptors but with ~5× greater GIPR potency. This dual mechanism is the basis for its enhanced metabolic efficacy over selective GLP-1 agonists.</p>
<h3 class="text-lg font-bold mb-3">Structural Features</h3><div class="space-y-2 mb-6">{features.map(([feat,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{feat}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}</div>
<h3 class="text-lg font-bold mb-3">Receptor Activity</h3><div class="overflow-x-auto rounded-2xl border border-gray-200 mb-6"><table class="w-full text-sm bg-white"><thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-accent-dark">GIP Receptor</th><th class="text-left py-3 px-4 font-semibold text-primary">GLP-1 Receptor</th></tr></thead><tbody>{receptor.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-accent-dark font-medium text-sm">{r[1]}</td><td class="py-3 px-4 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody></table></div>
<h3 class="text-lg font-bold mb-3">Research Focus Areas</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-3">{focusAreas.map(([a,f])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{a}</span><p class="text-gray-500 text-xs mt-1">{f}</p></div>))}</div></div></div></section>

<section class="section bg-surface"><div class="container-wide mx-auto px-4"><h2 class="mb-6">Tirzepatide vs Semaglutide vs Retatrutide</h2><div class="max-w-4xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm"><table class="w-full text-sm bg-white"><thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Semaglutide</th><th class="text-left py-3 px-4 font-semibold text-accent-dark">Tirzepatide</th><th class="text-left py-3 px-4 font-semibold text-primary">Retatrutide</th></tr></thead><tbody>{comparison.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-sm">{r[1]}</td><td class="py-3 px-4 text-accent-dark font-medium text-sm">{r[2]}</td><td class="py-3 px-4 text-gray-600 text-sm">{r[3]}</td></tr>))}</tbody></table></div></div></section>

<section class="section bg-white"><div class="container-wide mx-auto px-4"><h2 class="text-center mb-6">Quality Specifications</h2><div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm"><table class="w-full text-sm bg-white"><thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead><tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody></table></div><p class="text-gray-500 text-sm mt-4 text-center">Tirzepatide purification is more challenging than Semaglutide — 39 AA with closely related deletion peptides and oxidation products require optimized HPLC gradients.</p></div></section>

<section class="section bg-surface"><div class="container-wide mx-auto px-4"><h2 class="text-center mb-6">Tiered Wholesale Pricing</h2><div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm"><table class="w-full text-sm bg-white"><thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead><tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody></table></div></div></section>

<section class="section bg-white"><div class="container-narrow mx-auto px-4"><h2 class="text-center mb-8">FAQ</h2><div class="space-y-3 max-w-3xl mx-auto">
<details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Tirzepatide differ from Semaglutide mechanistically?</summary><p class="mt-3 text-gray-600 text-sm">Semaglutide activates only GLP-1R. Tirzepatide activates both GIPR and GLP-1R — the GIP component adds insulinotropic effects, improved lipid handling, and better insulin sensitivity. Read the full comparison in our <a href="/blog/glp1-buyers-guide/" class="text-accent-dark hover:underline">GLP-1 Buyer's Guide →</a></p></details>
<details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Why is Tirzepatide more expensive than Semaglutide?</summary><p class="mt-3 text-gray-600 text-sm">Three factors: longer sequence (39 vs 31 AA → more coupling steps, higher material costs), more challenging purification, and higher demand relative to capacity (Tirzepatide is in "differentiation" phase with growing demand).</p></details>
<details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What salt form is your Tirzepatide?</summary><p class="mt-3 text-gray-600 text-sm">Standard is the acetate salt. If your protocol requires Na, TFA, or another counterion, specify in your inquiry — salt form can be adjusted during the final purification/lyophilization stage.</p></details>
<details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How do you confirm the identity — not just purity — of Tirzepatide?</summary><p class="mt-3 text-gray-600 text-sm">Every batch undergoes both HPLC (purity, ≥99% peak area) AND ESI-MS (identity, confirming MW ~4,813.5 Da). For bulk orders: linker integrity by HPLC-ELSD or LC-MS/MS to confirm intact C20 fatty diacid conjugation.</p></details>
</div></div></section>

<section class="section bg-surface"><div class="container-wide mx-auto px-4"><h2 class="text-center mb-6">Related Products</h2><div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
<a href="/products/semaglutide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Semaglutide</span><span class="text-gray-500 text-xs">Volume driver GLP-1</span></a>
<a href="/products/retatrutide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Retatrutide</span><span class="text-gray-500 text-xs">Triple agonist</span></a>
<a href="/products/cagrilintide/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Cagrilintide</span><span class="text-gray-500 text-xs">Amylin analogue</span></a>
<a href="/products/metabolic/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">AOD-9604</span><span class="text-gray-500 text-xs">Lipolytic hGH</span></a>
</div></div></section>

<section class="section bg-white"><div class="container-narrow mx-auto px-4 text-center"><p class="text-gray-500 text-sm max-w-2xl mx-auto"><strong>FOR LABORATORY RESEARCH USE ONLY.</strong> Not for human or veterinary diagnostic, therapeutic, or any clinical use.</p></div></section>

<section class="section bg-primary py-16 text-center"><div class="container-wide mx-auto px-4"><h2 class="text-white text-3xl mb-4">Ready to Source Tirzepatide?</h2><p class="text-gray-300 max-w-xl mx-auto mb-8">Premium dual-agonist differentiation. Tiered pricing up to 70%. COA + MS + linker integrity with every bulk order.</p><div class="flex justify-center gap-4 flex-wrap"><a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a></div></div></section>

<div class="text-center py-6 bg-surface"><a href="/products/metabolic/" class="text-accent-dark font-medium hover:underline">← Back to Metabolic</a></div>
</PageLayout>
