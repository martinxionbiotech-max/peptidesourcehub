---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Semax Wholesale — Research-Grade ACTH(4-7) Analog Nootropic Neuroprotective Peptide",
  "description": "Factory-direct Semax wholesale. CAS 80714-61-0, ~813.9 Da. ≥99% HPLC. BDNF/NGF upregulator — neuroprotection &amp; cognitive enhancement. COA included.",
  "sku": "PSH-SEMAX-10MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","80714-61-0"],
  ["Sequence","Met-Glu-His-Phe-Pro-Gly-Pro-OH"],
  ["Amino Acids","7 (ACTH(4-7) + Pro-Gly-Pro C-terminal)"],
  ["Molecular Formula","C₃₇H₅₁N₉O₁₀S"],
  ["Molecular Weight","~813.9 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","10 mg × 10 vials","Neuroprotection studies; evaluation"],
  ["Bulk Kit","30 mg × 10 vials","Chronic cognitive models; repeat orders"],
  ["Custom","Custom mg × custom vials","OEM; private-label"]
];

const focusAreas = [
  ["Neuroprotection","Ischemia/hypoxia models — neuronal survival enhancement"],
  ["Cognitive Enhancement","Learning & memory consolidation in rodent models"],
  ["BDNF/NGF Upregulation","Neurotrophin expression — synaptic plasticity support"],
  ["Stroke Recovery","Post-ischemic neurological function improvement"],
  ["Optic Nerve Protection","Retinal ganglion cell survival in glaucoma models"]
];

const mechanisms = [
  ["BDNF/NGF Upregulation","Enhanced transcription of neurotrophins → synaptic plasticity"],
  ["Melanocortin Receptor","MC4/MC5 receptor agonism → cAMP → CREB-mediated neurotrophin gene expression"],
  ["C-terminal PGP Motif","Pro-Gly-Pro extension enhances metabolic stability and BBB penetration"],
  ["Anti-Inflammatory","Reduced microglial activation; decreased IL-1β and TNF-α in CNS"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~813.9 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["Met Oxidation","HPLC-MS","Met(O) ≤ 1%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; protocol validation"],
  ["2–5 kits","10–20% off","Small groups; initial stocking"],
  ["6–20 kits","25–40% off","Mid-size distributors"],
  ["21–50 kits","40–55% off","Regional distributors; OEM pilot"],
  ["50+ kits","55–70% off","Large distributors; recurring supply"]
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is Semax and how does it relate to ACTH?", "acceptedAnswer": { "@type": "Answer", "text": "Semax is a synthetic heptapeptide based on ACTH(4–7), the N-terminal fragment of ACTH that mediates neurotrophic effects without adrenal steroidogenesis. The C-terminal Pro-Gly-Pro extension confers metabolic stability and CNS penetration." } },
    { "@type": "Question", "name": "What is the mechanism of Semax's cognitive effects?", "acceptedAnswer": { "@type": "Answer", "text": "Semax primarily upregulates BDNF and NGF via melanocortin receptor activation. Elevated neurotrophins support synaptic plasticity, neuronal survival, and cognitive function. Additional effects include anti-inflammatory microglial modulation and improved cerebral blood flow." } },
    { "@type": "Question", "name": "How does the Pro-Gly-Pro extension work?", "acceptedAnswer": { "@type": "Answer", "text": "The C-terminal PGP tripeptide protects from carboxypeptidase degradation and enhances blood-brain barrier penetration. The Pro-Gly-Pro sequence itself has reported glyproline activity that may contribute to neuroprotection." } },
    { "@type": "Question", "name": "How does Semax differ from Selank?", "acceptedAnswer": { "@type": "Answer", "text": "Both are Russian-developed nootropics with distinct mechanisms. Semax (ACTH-derived) → melanocortin receptors → BDNF/NGF → cognition. Selank (tuftsin-derived) → GABAergic/dopaminergic → anxiolysis. Complementary: Semax for cognition, Selank for anxiety." } },
    { "@type": "Question", "name": "What purity and QC is provided for Semax?", "acceptedAnswer": { "@type": "Answer", "text": "≥99% HPLC with ESI-MS identity. Special QC: Met(O) content ≤ 1% (N-terminal methionine is oxidation-sensitive). Batch-specific COA included." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Nootropic &amp; Anti-Aging", "item": "https://peptidesourcehub.com/products/nootropic-anti-aging/" },
    { "@type": "ListItem", "position": 4, "name": "Semax" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="Semax Wholesale — Research-Grade ACTH(4-7) Analog Nootropic Neuroprotective Peptide"
  description="Factory-direct Semax wholesale. CAS 80714-61-0, ~813.9 Da. ≥99% HPLC. BDNF/NGF upregulator — neuroprotection &amp; cognitive enhancement. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/nootropic-anti-aging/" class="text-gray-400 hover:text-white">Nootropic &amp; Anti-Aging</a><span class="text-gray-600">/</span>
      <span class="text-accent">Semax</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Semax Wholesale</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">ACTH(4–7)-Pro-Gly-Pro heptapeptide — BDNF upregulation & neuroprotection research, manufacturer-direct</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Identity -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Product Identity & Specifications</h2>
    <div class="max-w-3xl overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <tbody>
          {specs.map(([k,v],i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary w-1/3">{k}</td><td class="py-3 px-5 text-gray-600">{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Available Configurations</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Configuration</th><th class="text-left py-3 px-5 font-semibold text-primary">Content</th><th class="text-left py-3 px-5 font-semibold text-primary">Best For</th></tr></thead>
        <tbody>{configs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Research Background -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="mb-6">Research Background</h2>
    <div class="max-w-4xl">
      <p class="text-gray-600 mb-6">Semax is a synthetic heptapeptide developed at the Institute of Molecular Genetics of the Russian Academy of Sciences. It consists of the ACTH(4–7) fragment (Met-Glu-His-Phe) — the active core of adrenocorticotropic hormone that mediates neurotrophic effects without steroidogenic activity — extended with a C-terminal Pro-Gly-Pro tripeptide. Semax is the most extensively characterized nootropic peptide in the literature, with documented effects on BDNF and NGF expression, cognitive function, and neuroprotection across multiple paradigms.</p>
      <h3 class="text-lg font-bold mb-3">Published Research Focus Areas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        {focusAreas.map(([area,finding])=>(<div class="card p-4"><span class="font-semibold text-primary text-sm">{area}</span><p class="text-gray-500 text-xs mt-1">{finding}</p></div>))}
      </div>
      <h3 class="text-lg font-bold mb-3">Proposed Mechanisms</h3>
      <div class="space-y-2">
        {mechanisms.map(([mech,desc])=>(<div class="card p-4"><span class="font-semibold text-accent-dark text-sm">{mech}</span><span class="text-gray-600 text-sm ml-2">{desc}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- Quality -->
<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Quality Specifications</h2>
    <div class="max-w-3xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-4 font-semibold text-primary">Parameter</th><th class="text-left py-3 px-4 font-semibold text-primary">Method</th><th class="text-left py-3 px-5 font-semibold text-primary">Criterion</th></tr></thead>
        <tbody>{qcSpecs.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-4 font-semibold text-primary text-sm">{r[0]}</td><td class="py-3 px-4 text-gray-600 text-xs">{r[1]}</td><td class="py-3 px-5 text-accent-dark font-medium text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Tiered Wholesale Pricing</h2>
    <div class="max-w-2xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Volume</th><th class="text-left py-3 px-5 font-semibold text-primary">Discount</th><th class="text-left py-3 px-5 font-semibold text-primary">For</th></tr></thead>
        <tbody>{pricing.map((r,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'}`}><td class="py-3 px-5 font-semibold text-primary">{r[0]}</td><td class="py-3 px-5 text-accent-dark font-medium">{r[1]}</td><td class="py-3 px-5 text-gray-600 text-sm">{r[2]}</td></tr>))}</tbody>
      </table>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is Semax and how does it relate to ACTH?</summary><p class="mt-3 text-gray-600 text-sm">Semax is a synthetic heptapeptide based on ACTH(4–7), the N-terminal fragment of ACTH that mediates neurotrophic effects without adrenal steroidogenesis. The C-terminal Pro-Gly-Pro extension confers metabolic stability and CNS penetration.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the mechanism of Semax's cognitive effects?</summary><p class="mt-3 text-gray-600 text-sm">Semax primarily upregulates BDNF and NGF via melanocortin receptor activation. Elevated neurotrophins support synaptic plasticity, neuronal survival, and cognitive function. Additional effects include anti-inflammatory microglial modulation and improved cerebral blood flow.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does the Pro-Gly-Pro extension work?</summary><p class="mt-3 text-gray-600 text-sm">The C-terminal PGP tripeptide protects from carboxypeptidase degradation and enhances blood-brain barrier penetration. The Pro-Gly-Pro sequence itself has reported glyproline activity that may contribute to neuroprotection.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does Semax differ from Selank?</summary><p class="mt-3 text-gray-600 text-sm">Both are Russian-developed nootropics with distinct mechanisms. Semax (ACTH-derived) → melanocortin receptors → BDNF/NGF → cognition. Selank (tuftsin-derived) → GABAergic/dopaminergic → anxiolysis. Complementary: Semax for cognition, Selank for anxiety.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What purity and QC is provided for Semax?</summary><p class="mt-3 text-gray-600 text-sm">≥99% HPLC with ESI-MS identity. Special QC: Met(O) content ≤ 1% (N-terminal methionine is oxidation-sensitive). Batch-specific COA included.</p></details>
    </div>
  </div>
</section>

<!-- Related Products -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-6">Related Products</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Selank</span><span class="text-gray-500 text-xs">Tuftsin-derived anxiolytic</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Epithalon</span><span class="text-gray-500 text-xs">Telomerase activator</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">DSIP</span><span class="text-gray-500 text-xs">Sleep architecture peptide</span></a>
      <a href="/products/nootropic-anti-aging/" class="card p-4 text-center hover:border-accent/30 transition-colors"><span class="font-semibold text-primary block">Nootropic Category</span><span class="text-gray-500 text-xs">All cognitive peptides</span></a>
    </div>
  </div>
</section>

<!-- Compliance -->
<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <p class="text-gray-500 text-sm max-w-2xl mx-auto">All products are manufactured for <strong>laboratory research purposes only</strong>. Semax is labeled FOR LABORATORY RESEARCH USE ONLY. Not for human or veterinary diagnostic/therapeutic/prophylactic use. Not a dietary supplement, pharmaceutical ingredient, or approved drug substance.</p>
  </div>
</section>

<!-- CTA -->
<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source Semax?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing, tiered discounts up to 70%, COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/nootropic-anti-aging/" class="text-accent-dark font-medium hover:underline">← Back to Nootropic &amp; Anti-Aging</a></div>

</PageLayout>
