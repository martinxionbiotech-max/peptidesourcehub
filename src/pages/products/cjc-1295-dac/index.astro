---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CJC-1295 (DAC) Wholesale — Long-Acting GHRH Analogue Peptide",
  "description": "Factory-direct CJC-1295 with DAC wholesale. CAS 863288-34-0, ~3,649.2 Da. ≥99% HPLC. Long-acting GHRH analogue. COA included.",
  "sku": "PSH-CJC1295D-2MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
    ["CAS Number","863288-34-0"],
    ["Sequence","Tyr-D-Ala-Asp-Ala-Ile-Phe-Thr-Gln-Ser-Tyr-Arg-Lys-Val-Leu-Ala-Gln-Leu-Ser-Ala-Arg-Lys-Leu-Leu-Gln-Asp-Ile-Leu-Ser-Arg-Lys(Maleimidopropionyl)-NH₂"],
    ["Amino Acids","30 (C-terminal DAC linker)"],
    ["Molecular Formula","C₁₅₂H₂₅₂N₄₄O₄₂"],
    ["Molecular Weight","~3,649.2 Da"],
    ["Appearance","White to off-white lyophilized powder"],
    ["Purity","≥99% by HPLC"],
    ["Solubility","Soluble in sterile or bacteriostatic water"],
    ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
    ["Standard Kit","2 mg × 10 vials","GH pulse research; evaluation"],
    ["Bulk Kit","5 mg × 10 vials","Chronic GH axis studies; repeat orders"],
    ["Custom","Custom mg × custom vials","OEM; private-label; protocol-specific"]
];

const focusAreas = [
    ["GH Secretion","Sustained GHRH receptor activation → prolonged GH elevation"],
    ["Body Composition","Lean mass preservation; fat mass reduction models"],
    ["Muscle Protein Synthesis","GH/IGF-1 axis-mediated anabolic signaling"],
    ["Recovery Research","Post-exercise GH pulse augmentation in trained models"]
];

const mechanisms = [
    ["GHRH-R Agonism","Full GHRH receptor activation → cAMP → GH synthesis and release from pituitary"],
    ["DAC-Albumin Conjugation","Maleimidopropionyl linker covalently binds Cys³⁴ of serum albumin → half-life extended from ~7 min to ~8 days"],
    ["IGF-1 Cascade","Sustained GH → hepatic IGF-1 production → systemic anabolic signaling"]
];

const qcSpecs = [
    ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
    ["Identity (MW)","ESI-MS","~3,649.2 ± 1.0 Da"],
    ["Appearance","Visual inspection","White to off-white powder"],
    ["Peptide Content","Amino acid analysis","≥80% net peptide"],
    ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is the DAC in CJC-1295?", "acceptedAnswer": { "@type": "Answer", "text": "DAC stands for Drug Affinity Complex — a maleimidopropionyl linker that covalently binds to Cys³⁴ of serum albumin. This conjugation extends half-life from minutes to ~8 days by preventing renal clearance and enzymatic degradation." } },
    { "@type": "Question", "name": "Difference between CJC-1295 with DAC and without DAC?", "acceptedAnswer": { "@type": "Answer", "text": "With DAC: ~8 day half-life → sustained GHRH activation → chronic GH/IGF-1. Without DAC: ~30 min half-life → discrete GH pulse → mimics endogenous pulsatile secretion. Choice depends on research objective." } },
    { "@type": "Question", "name": "Why pair CJC-1295 with Ipamorelin?", "acceptedAnswer": { "@type": "Answer", "text": "CJC-1295 amplifies the GHRH signal (the 'on' switch). Ipamorelin suppresses somatostatin tone (the 'off' switch). Together they produce a larger net GH pulse than either alone — well-characterized synergism." } },
    { "@type": "Question", "name": "How should CJC-1295 (DAC) be stored?", "acceptedAnswer": { "@type": "Answer", "text": "Lyophilized: 2–8°C, desiccated, 24-month stability. After reconstitution, store at 2–8°C. The DAC-albumin conjugate forms spontaneously — this is expected and part of the molecule's designed mechanism." } },
    { "@type": "Question", "name": "What configurations are available?", "acceptedAnswer": { "@type": "Answer", "text": "Standard: 2mg × 10 vials. Bulk: 5mg × 10 vials. Custom mg/vial for OEM/private-label. CJC-1295 (no DAC) also available as a separate SKU for pulsatile GH protocols." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Muscle Growth", "item": "https://peptidesourcehub.com/products/muscle-growth/" },
    { "@type": "ListItem", "position": 4, "name": "CJC-1295 (DAC)" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout title="CJC-1295 (DAC) Wholesale — Long-Acting GHRH Analogue Peptide"
  description="Factory-direct CJC-1295 with DAC wholesale. CAS 863288-34-0, ~3,649.2 Da. ≥99% HPLC. Long-acting GHRH analogue. COA included."
jsonLd={allJsonLd}>

<!-- Hero -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <a href="/products/muscle-growth/" class="text-gray-400 hover:text-white">Muscle Growth</a><span class="text-gray-600">/</span>
