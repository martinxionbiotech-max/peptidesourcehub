---
import PageLayout from "../../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Wholesale Metabolic Research Peptides — GLP-1 & Beyond",
  "description": "Factory-direct metabolic research peptides: Semaglutide, Tirzepatide, Retatrutide, Cagrilintide, AOD-9604. ≥99% HPLC purity, batch-traceable.",
  "isPartOf": { "@type": "WebSite", "name": "Peptides Source Hub", "url": "https://peptidesourcehub.com" },
};

const products = [
  ["Semaglutide","910463-68-2","4,113.6","GLP-1 receptor agonist — most researched incretin mimetic","5 mg × 10 vials"],
  ["Tirzepatide","2023788-19-2","4,813.5","Dual GIP/GLP-1 receptor agonist","5 mg × 10 vials"],
  ["Retatrutide","2381089-83-2","4,731.5","Triple GIP/GLP-1/GCGR agonist — next-gen","5 mg × 10 vials"],
  ["Cagrilintide","1415456-99-3","4,100.7","Long-acting amylin analogue","5 mg × 10 vials"],
  ["AOD-9604","221231-10-3","1,815.1","hGH fragment 177-191 — lipolytic","2 mg × 10 vials"],
];
---

<PageLayout
  title="Metabolic Research Peptides Wholesale"
  description="Factory-direct metabolic research peptides: Semaglutide, Tirzepatide, Retatrutide, Cagrilintide, AOD-9604. ≥99% HPLC purity, tiered wholesale pricing. COA included."
  {jsonLd}
>

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <span class="text-accent">Metabolic Research</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Metabolic Research Peptides</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">GLP-1 receptor agonists & metabolic modulators — factory-direct, batch-traceable</p>
    <div class="card bg-gradient-to-br from-emerald-50 to-white border-emerald-200 mt-6 p-5">
      <h2 class="text-sm uppercase tracking-widest text-gray-400 mb-3">Key Statistics</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div><span class="block text-2xl font-bold text-primary">5</span><span class="text-xs text-gray-500">Research Peptides</span></div>
        <div><span class="block text-2xl font-bold text-primary">3</span><span class="text-xs text-gray-500">Receptor Tiers (1/2/3)</span></div>
        <div><span class="block text-2xl font-bold text-primary">$125B</span><span class="text-xs text-gray-500">Market by 2030 [Source: Industry]</span></div>
        <div><span class="block text-2xl font-bold text-primary">10-70%</span><span class="text-xs text-gray-500">Bulk Discount Range</span></div>
      </div>
    </div>

  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="max-w-4xl">
      <p class="text-lg text-gray-600">The metabolic peptide category is the highest-volume segment in research peptide supply — driven by global demand for GLP-1 receptor agonists. PeptideSourceHub manufactures all five metabolic peptides in-house, with synthesis capacity scaled for bulk orders. Semaglutide and Tirzepatide together account for over 40% of our B2B production volume.</p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="/contact/" class="btn-primary group">Get a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
        <a href="/blog/peptide-quality-guide/" class="btn-outline text-primary border-primary/30 hover:bg-primary hover:text-white">Peptide Quality Guide →</a>
      </div>
    </div>
  </div>
</section>

<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-10">Receptor Target Comparison</h2>
    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="text-left py-3 px-5 font-semibold text-primary">Receptor</th>
            <th class="text-center py-3 px-4 font-semibold text-primary">Semaglutide</th>
            <th class="text-center py-3 px-4 font-semibold text-primary">Tirzepatide</th>
            <th class="text-center py-3 px-4 font-semibold text-primary">Retatrutide</th>
            <th class="text-center py-3 px-4 font-semibold text-primary">Cagrilintide</th>
            <th class="text-center py-3 px-4 font-semibold text-primary">AOD-9604</th>
            <th class="text-left py-3 px-5 font-semibold text-primary">Primary Effect</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100"><td class="py-3 px-5 font-medium text-primary">GLP-1R</td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="py-3 px-5 text-gray-600">Insulin secretion, gastric emptying</td></tr>
          <tr class="border-b border-gray-100 bg-gray-50/50"><td class="py-3 px-5 font-medium text-primary">GIPR</td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="py-3 px-5 text-gray-600">Insulin sensitivity, lipid metabolism</td></tr>
          <tr class="border-b border-gray-100"><td class="py-3 px-5 font-medium text-primary">GCGR</td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="py-3 px-5 text-gray-600">Energy expenditure, lipolysis</td></tr>
          <tr><td class="py-3 px-5 font-medium text-primary">AMY-R</td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="text-center py-3 px-4"><span class="text-green-600 font-bold">✓</span></td><td class="text-center py-3 px-4"><span class="text-gray-300">—</span></td><td class="py-3 px-5 text-gray-600">Appetite, delayed gastric emptying</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-10">Product Specifications</h2>
    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="text-left py-3 px-5 font-semibold text-primary">Product</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">CAS</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">MW (Da)</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">Research Context</th>
            <th class="text-left py-3 px-5 font-semibold text-primary">Std. Configuration</th>
          </tr>
        </thead>
        <tbody>
          {products.map((p,i) => (
            <tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'} hover:bg-accent/5`}>
              <td class="py-3 px-5 font-semibold text-primary">{p[0]}</td>
              <td class="py-3 px-4 text-gray-600 text-xs font-mono">{p[1]}</td>
              <td class="py-3 px-4 text-gray-600">{p[2]}</td>
              <td class="py-3 px-4 text-gray-600 text-sm">{p[3]}</td>
              <td class="py-3 px-5 font-medium text-accent-dark">{p[4]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-gray-500 text-sm mt-4 text-center">All products: ≥99% purity by HPLC · Lyophilized powder · COA included · Store at 2–8°C · Protect from light</p>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-10">Portfolio Strategy Scenarios</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="card p-6 text-center">
        <div class="text-4xl mb-4">🏪</div>
        <h3 class="font-bold mb-3">Distributor Portfolio</h3>
        <p class="text-gray-600 text-sm">Start with Semaglutide as your anchor SKU. Add Tirzepatide for premium positioning. Introduce Cagrilintide as complementary upsell.</p>
      </div>
      <div class="card p-6 text-center">
        <div class="text-4xl mb-4">🏷️</div>
        <h3 class="font-bold mb-3">Private-Label OEM</h3>
        <p class="text-gray-600 text-sm">Launch branded Semaglutide + Tirzepatide dual line. Differentiate with fixed-dose Cagrilintide/GLP-1 combination kits.</p>
      </div>
      <div class="card p-6 text-center">
        <div class="text-4xl mb-4">🔬</div>
        <h3 class="font-bold mb-3">Research Consortium</h3>
        <p class="text-gray-600 text-sm">Source all 5 molecules from one factory for protocol consistency. Batch traceability across the entire portfolio.</p>
      </div>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-10">FAQ</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What's the difference between Semaglutide and Tirzepatide?</summary><p class="mt-3 text-gray-600 text-sm">Semaglutide activates GLP-1 receptors only. Tirzepatide activates both GLP-1 and GIP receptors. In research, dual agonism shows enhanced metabolic effects compared to GLP-1 alone. Retatrutide adds a third target (GCGR).</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Do you offer fixed-dose combination kits?</summary><p class="mt-3 text-gray-600 text-sm">Yes. We produce custom fixed-dose combinations — for example, Cagrilintide 5mg + Semaglutide 5mg in a single vial. Minimum order quantities apply for custom formulations.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What purity do your GLP-1 peptides meet?</summary><p class="mt-3 text-gray-600 text-sm">All five products target ≥99% purity by HPLC. Lower-purity material is not released. Full analytical documentation — HPLC chromatogram, mass spectrometry data — available on request with every batch.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">How does volume pricing work for bulk orders?</summary><p class="mt-3 text-gray-600 text-sm">Tiered pricing starts at 1-3 kits, with progressive discounts at 4-9 kits, 10-24 kits, 25-49 kits, and 50+ kits. Contact our sales team for a detailed quotation based on your projected monthly volume.</p></details>
    </div>
  </div>
</section>

<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source GLP-1 Peptides?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing on all five metabolic peptides. COA, HPLC, and MS documentation with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request Wholesale Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
      <a href="/blog/peptide-quality-guide/" class="btn-outline text-white border-white/40 hover:bg-white/10 text-lg">Quality Guide →</a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface">
  <a href="/products/" class="text-accent-dark font-medium hover:underline">← Back to All Categories</a>
</div>

</PageLayout>
