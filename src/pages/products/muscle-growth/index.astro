---
import PageLayout from "../../../layouts/PageLayout.astro";
import RuoNotice from "../../../components/RuoNotice.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Wholesale Muscle Growth Peptide Kits — GH Secretagogue Research",
  "description": "Factory-direct CJC-1295, Ipamorelin, GHRP-2, GHRP-6, PEG-MGF. ≥99% HPLC purity, tiered wholesale pricing, batch-traceable.",
  "isPartOf": { "@type": "WebSite", "name": "Peptides Source Hub", "url": "https://peptidesourcehub.net" },
};

const products = [
  ["CJC-1295 (DAC)","863288-34-0","3,649.2","Long-acting GHRH analogue — sustained GH pulse","2 mg × 10 vials","/products/cjc-1295-dac/"],
  ["Ipamorelin","170851-70-4","711.9","Selective GHS-R agonist — minimal hunger signal","2 mg × 10 vials","/products/ipamorelin/"],
  ["GHRP-2","158861-67-7","817.0","Potent ghrelin receptor agonist","5 mg × 10 vials","/products/ghrp-2/"],
  ["GHRP-6","87616-84-0","873.0","Ghrelin mimetic — strong GH release","5 mg × 10 vials","/products/ghrp-6/"],
  ["PEG-MGF","—","11,500","IGF-1 splice variant — muscle stem cell activation","1 mg × 10 vials","/products/peg-mgf/"],
  ["CJC-1295 (no DAC)","863288-34-0","3,367.1","Short-acting GHRH — pulse-compatible","2 mg × 10 vials","/products/cjc-1295-no-dac/"],
  ["Sermorelin", "86168-78-7", "3,357.9", "GHRH(1–29) — GHRH-receptor agonist reference peptide", "5 mg × 10 vials", "/products/sermorelin/"],
  ["Tesamorelin", "218949-48-5", "5,136", "GHRH(1–44) analogue — stabilised GHRH-receptor agonist", "5 mg × 10 vials", "/products/tesamorelin/"],,
  ["IGF-1 LR3","Per batch COA","—","Recombinant long R3 analogue — reduced IGFBP affinity for IGF-1R signalling research","0.1 mg × 10 vials","/products/igf-1-lr3/"]
];

const combos = [
  ["CJC-1295 + Ipamorelin","DAC-GHRH + selective GHS-R","Sustained GH elevation, low side-effect","GH secretagogue research"],
  ["CJC-1295 (no DAC) + GHRP-2","Pulsed GHRH + strong GHS-R","Sharp GH pulse, post-exercise window","Pulsatile GH models"],
  ["CJC-1295 + Ipamorelin + PEG-MGF","GH elevation + satellite cell","GH axis coverage + repair","Regeneration protocols"],
];
const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the difference between CJC-1295 with DAC and without DAC?", "acceptedAnswer": {"@type": "Answer", "text": "CJC-1295 with DAC (Drug Affinity Complex) binds covalently to serum albumin, extending half-life from minutes to ~8 days. This provides sustained GHRH receptor activation. The no-DAC variant produces a shorter, more physiological GH pulse — preferred when pulsatile GH release is the research objective."}}, {"@type": "Question", "name": "Why pair CJC-1295 with Ipamorelin?", "acceptedAnswer": {"@type": "Answer", "text": "CJC-1295 amplifies the endogenous GHRH signal (the \"on\" switch). Ipamorelin suppresses somatostatin tone (the \"off\" switch) through selective ghrelin receptor agonism. Together they produce a larger net GH pulse than either peptide alone. This synergism is well-characterized in endocrinology literature."}}, {"@type": "Question", "name": "What distinguishes Ipamorelin from GHRP-2 and GHRP-6?", "acceptedAnswer": {"@type": "Answer", "text": "Selectivity. Ipamorelin is the most selective ghrelin receptor agonist of the three, producing minimal hunger signaling and cortisol elevation at research doses. GHRP-2 and GHRP-6 are more potent GH releasers but with broader receptor profiles."}}]};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Muscle Growth" }
  ]
};
const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
---

<PageLayout
  title="Muscle Growth Peptides | Wholesale"
  description="CJC-1295, Ipamorelin, GHRP-2, GHRP-6 and PEG-MGF for muscle and growth research: ≥99% HPLC purity, 10-vial kits, COA per batch, wholesale tiers."
  jsonLd={allJsonLd}
>
<RuoNotice />

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 relative z-10 animate-on-scroll">
    <nav class="flex items-center gap-2 mb-4 text-sm" aria-label="Breadcrumb">
      <a href="/" class="text-gray-400 hover:text-white">Home</a><span class="text-gray-600">/</span>
      <a href="/products/" class="text-gray-400 hover:text-white">Products</a><span class="text-gray-600">/</span>
      <span class="text-accent">Muscle Growth</span>
    </nav>
    <h1 class="text-white text-3xl md:text-5xl">Muscle Growth Peptide Kits</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl">GH secretagogue research — factory-direct, batch-traceable</p>
    <div class="mt-4">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-5 py-2.5 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Product List & Price (PDF)
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>

    <div class="card bg-gradient-to-br from-orange-50 to-white border-orange-200 mt-6 p-5">
      <h2 class="text-sm uppercase tracking-widest text-gray-400 mb-3">Key Statistics</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div><span class="block text-2xl font-bold text-primary">6</span><span class="text-xs text-gray-500">Core Molecules</span></div>
        <div><span class="block text-2xl font-bold text-primary">~22,125</span><span class="text-xs text-gray-500">HGH MW (Da)</span></div>
        <div><span class="block text-2xl font-bold text-primary">3</span><span class="text-xs text-gray-500">Kit Configs (100/150/200 IU)</span></div>
        <div><span class="block text-2xl font-bold text-primary">10–30%</span><span class="text-xs text-gray-500">Bulk Discount Range</span></div>
      </div>
    </div>

  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="max-w-4xl">
      <p class="text-lg text-gray-600">The GH secretagogue category covers peptides that stimulate growth hormone release through distinct pituitary pathways. CJC-1295 (with DAC) provides sustained GHRH receptor activation — ideal for chronic GH elevation protocols. Ipamorelin offers the most selective ghrelin receptor agonism in the category, minimizing off-target appetite signaling compared to GHRP-2 and GHRP-6. The CJC-1295/Ipamorelin combination is our most frequently ordered pair in this category.</p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="/contact/" class="btn-primary group">Get a Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
      </div>
    </div>
  </div>
</section>

<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-10">Product Specifications</h2>
    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead><tr class="bg-gray-50 border-b-2 border-gray-200"><th class="text-left py-3 px-5 font-semibold text-primary">Product</th><th class="text-left py-3 px-4 font-semibold text-primary">CAS</th><th class="text-left py-3 px-4 font-semibold text-primary">MW (Da)</th><th class="text-left py-3 px-4 font-semibold text-primary">Research Context</th><th class="text-left py-3 px-5 font-semibold text-primary">Std. Configuration</th></tr></thead>
        <tbody>
          {products.map((p,i)=>(<tr class={`border-b border-gray-100 ${i%2===0?'bg-white':'bg-gray-50/50'} hover:bg-accent/5`}><td class="py-3 px-5 font-semibold text-primary"><a href={p[5]} class="hover:text-accent transition-colors">{p[0]}</a></td><td class="py-3 px-4 text-gray-600 text-xs font-mono">{p[1]}</td><td class="py-3 px-4 text-gray-600">{p[2]}</td><td class="py-3 px-4 text-gray-600 text-sm">{p[3]}</td><td class="py-3 px-5 font-medium text-accent-dark">{p[4]}</td></tr>))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-10">Protocol Combinations</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {combos.map(([title,peps,mech,use]) => (
        <div class="card p-6 text-center">
          <div class="text-3xl mb-3">💪</div>
          <h3 class="font-bold">{title}</h3>
          <p class="text-accent-dark text-sm font-mono my-2">{peps}</p>
          <p class="text-gray-500 text-xs">{mech}</p>
          <p class="text-gray-400 text-xs mt-1">{use}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-10">FAQ</h2>
    <div class="space-y-3 max-w-3xl mx-auto">
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What is the difference between CJC-1295 with DAC and without DAC?</summary><p class="mt-3 text-gray-600 text-sm">CJC-1295 with DAC (Drug Affinity Complex) binds covalently to serum albumin, extending half-life from minutes to ~8 days. This provides sustained GHRH receptor activation. The no-DAC variant produces a shorter, more physiological GH pulse — preferred when pulsatile GH release is the research objective.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">Why pair CJC-1295 with Ipamorelin?</summary><p class="mt-3 text-gray-600 text-sm">CJC-1295 amplifies the endogenous GHRH signal (the "on" switch). Ipamorelin suppresses somatostatin tone (the "off" switch) through selective ghrelin receptor agonism. Together they produce a larger net GH pulse than either peptide alone. This synergism is well-characterized in endocrinology literature.</p></details>
      <details class="card group cursor-pointer"><summary class="font-semibold text-primary hover:text-accent">What distinguishes Ipamorelin from GHRP-2 and GHRP-6?</summary><p class="mt-3 text-gray-600 text-sm">Selectivity. Ipamorelin is the most selective ghrelin receptor agonist of the three, producing minimal hunger signaling and cortisol elevation at research doses. GHRP-2 and GHRP-6 are more potent GH releasers but with broader receptor profiles.</p></details>
    </div>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-4">Selecting a GH-Axis SKU</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto mb-8">GH secretagogues differ less by headline potency than by release profile and receptor selectivity. The table starts from the exposure pattern a study needs, because that choice drives the comparator, the sampling interval and the analytics worth insisting on.</p>
    <div class="max-w-5xl mx-auto overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
      <table class="w-full text-sm bg-white">
        <thead>
          <tr class="bg-gray-50 border-b-2 border-gray-200">
            <th class="text-left py-3 px-5 font-semibold text-primary">Exposure pattern</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">Catalog SKU</th>
            <th class="text-left py-3 px-4 font-semibold text-primary">Profile</th>
            <th class="text-left py-3 px-5 font-semibold text-primary">Analytical check</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100 bg-white"><td class="py-3 px-5 font-medium text-primary">Sustained GHRH-receptor activation</td><td class="py-3 px-4 text-gray-600 text-sm">CJC-1295 (DAC)</td><td class="py-3 px-4 text-gray-600 text-sm">Albumin-binding, long-acting</td><td class="py-3 px-4 text-gray-600 text-sm">Mass confirms the DAC modification</td></tr>
          <tr class="border-b border-gray-100 bg-gray-50/50"><td class="py-3 px-5 font-medium text-primary">Pulsatile GHRH release</td><td class="py-3 px-4 text-gray-600 text-sm">CJC-1295 (no DAC)</td><td class="py-3 px-4 text-gray-600 text-sm">Short-acting</td><td class="py-3 px-4 text-gray-600 text-sm">Distinguish from the DAC form</td></tr>
          <tr class="border-b border-gray-100 bg-white"><td class="py-3 px-5 font-medium text-primary">Selective GHS-R agonism</td><td class="py-3 px-4 text-gray-600 text-sm">Ipamorelin</td><td class="py-3 px-4 text-gray-600 text-sm">Narrow ghrelin-receptor profile</td><td class="py-3 px-4 text-gray-600 text-sm">Purity and identity</td></tr>
          <tr class="border-b border-gray-100 bg-gray-50/50"><td class="py-3 px-5 font-medium text-primary">Broad ghrelin agonism comparator</td><td class="py-3 px-4 text-gray-600 text-sm">GHRP-2 or GHRP-6</td><td class="py-3 px-4 text-gray-600 text-sm">Potent, wider receptor profile</td><td class="py-3 px-4 text-gray-600 text-sm">One COA per lot</td></tr>
          <tr class="border-b border-gray-100 bg-white"><td class="py-3 px-5 font-medium text-primary">Local IGF-1 splice-variant work</td><td class="py-3 px-4 text-gray-600 text-sm">PEG-MGF</td><td class="py-3 px-4 text-gray-600 text-sm">PEGylated, 11,500 Da</td><td class="py-3 px-4 text-gray-600 text-sm">PEG load confirmed by MS</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-gray-500 text-sm mt-4 text-center max-w-3xl mx-auto">Sermorelin and Tesamorelin extend the GHRH-receptor series, while IGF-1 LR3 acts on the IGF-1 receptor; none of them is interchangeable with the ghrelin-receptor agonists in a protocol design.</p>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">How to Evaluate a Quote in This Category</h2>
    <div class="card p-6 max-w-3xl mx-auto">
      <p class="text-gray-600">GHRH analogues are amidated at the C-terminus, and a supplier that cannot show that in the mass spectrum has not demonstrated the molecule you ordered. Ask for:</p>
      <ul class="mt-4 space-y-2 text-sm text-gray-600 list-disc pl-5">
          <li><span class="font-medium text-primary">COA</span> — batch-specific and legible</li>
          <li><span class="font-medium text-primary">HPLC</span> — chromatogram with integration shown</li>
          <li><span class="font-medium text-primary">MS</span> — mass matching the modified sequence, including the DAC group on CJC-1295 (DAC) and the PEG load on PEG-MGF</li>
          <li><span class="font-medium text-primary">Batch number</span> — matching the vials</li>
          <li><span class="font-medium text-primary">Retest date</span> — printed, not promised</li>
      </ul>
      <p class="mt-4 text-sm text-gray-500">For GHRP-2 and GHRP-6, ask for a separate COA per lot if you intend to compare them. A quote that cannot name the batch is a quote for a category, not a product.</p>
    </div>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4">
    <h2 class="text-center mb-8">Where This Category Does Not Fit</h2>
    <div class="card p-6 max-w-3xl mx-auto bg-gradient-to-br from-amber-50 to-white border-amber-200">
      <p class="text-gray-600">None of these products is a growth-hormone medicine, and this category is not intended for clinical investigation, endocrine therapy, athletic use or veterinary application. A laboratory that needs a recombinant protein supported by a drug master file, or material released against a pharmacopoeial monograph, should not source here. The catalog supports receptor-level and analytical research; it does not support anything that requires a prescriber, a clinical protocol or a regulatory submission.</p>
    </div>
  </div>
</section>

<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Source GH Peptides?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Bulk pricing on all six GH secretagogue peptides. COA with every order.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/contact/" class="btn-primary text-lg group">Request Wholesale Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </div>
</section>

<div class="text-center py-6 bg-surface"><a href="/products/" class="text-accent-dark font-medium hover:underline">← Back to All Categories</a></div>

</PageLayout>
