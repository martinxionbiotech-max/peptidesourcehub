---
import PageLayout from "../../layouts/PageLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Peptide Wholesale Catalog — 58 Factory-Direct Research Peptides",
  "description": "Browse 58 factory-direct research peptides organized by category. ≥99% purity, tiered wholesale pricing, batch-traceable. COA with every order.",
  "isPartOf": { "@type": "WebSite", "name": "Peptides Source Hub", "url": "https://peptidesourcehub.com" },
};

const categories = [
  { slug: "cosmetic-skin", title: "Cosmetic & Skin Peptides", icon: "M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42", desc: "GHK-Cu, Snap-8, Leuphasyl, Argireline — dermatological research and cosmetic formulation.", count: "8" },
  { slug: "healing-recovery", title: "Healing & Recovery Peptides", icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z", desc: "BPC-157, TB-500, Thymosin Beta-4, ARA-290 — tissue repair and inflammation research.", count: "7" },
  { slug: "metabolic", title: "Metabolic Research Peptides", icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z", desc: "Semaglutide, Tirzepatide, Retatrutide, Cagrilintide — GLP-1 and metabolic pathway research.", count: "12" },
  { slug: "muscle-growth", title: "Muscle Growth Peptide Kits", icon: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z", desc: "CJC-1295, Ipamorelin, GHRP-2, GHRP-6, PEG-MGF — GH secretagogue research.", count: "11" },
  { slug: "nootropic-anti-aging", title: "Nootropic & Anti-Aging Peptides", icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z", desc: "Semax, Selank, Epithalon, DSIP, FOXO4-DRI — cognitive and longevity research.", count: "10" },
  { slug: "specialty-stacks", title: "Specialty Stack Peptides", icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10", desc: "Pre-formulated multi-peptide combinations. Custom stack development for OEM partners.", count: "10" },
];

const specs = [
  ["Purity", "≥99% by HPLC"],
  ["Form", "Lyophilized powder, sterile glass vials"],
  ["Kit Size", "10 vials/kit"],
  ["Documentation", "COA included; HPLC/MS on request"],
  ["Storage", "2–8°C"],
  ["Pricing", "Tiered wholesale — 10–70% off for 2+ kits"],
  ["Shipping", "Free worldwide on orders over $500"],
  ["Compliance", "FOR LABORATORY RESEARCH USE ONLY"],
];
---

<PageLayout
  title="Peptide Wholesale Catalog"
  description="Browse 58 factory-direct research peptides organized by category. ≥99% purity, tiered wholesale pricing, COA documentation with every order."
  {jsonLd}
>

<!-- Header -->
<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 text-center relative z-10 animate-on-scroll">
    <h1 class="text-white">Peptide Wholesale Catalog</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl mx-auto">
      58 research-grade peptides manufactured in our Shenzhen facility. Every product ships with COA documentation.
    </p>
  </div>
</section>

<!-- Category Cards -->
<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {categories.map(({ slug, title, icon, desc, count }) => (
        <a href={`/products/${slug}/`} class="card group p-7 hover:-translate-y-1.5 hover:border-accent/20">
          <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-4 group-hover:bg-accent/20 group-hover:scale-110 transition-all duration-300">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={icon}/>
            </svg>
          </div>

          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-bold mb-2 group-hover:text-accent transition-colors">
              {title}
              <span class="inline-block ml-2 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-accent">→</span>
            </h2>
          </div>

          <p class="text-gray-600 text-sm leading-relaxed mb-3">{desc}</p>

          <!-- Product count tag -->
          <span class="inline-flex items-center gap-1 text-xs font-medium text-accent bg-accent/5 px-2.5 py-1 rounded-full">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            {count} products
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Specs Table -->
<section class="section dot-pattern">
  <div class="container-wide mx-auto px-4">
    <div class="text-center mb-12 animate-on-scroll">
      <h2>Standard Specifications</h2>
      <p class="text-gray-500 mt-4 max-w-2xl mx-auto">All products manufactured to these baseline standards.</p>
    </div>

    <div class="max-w-3xl mx-auto animate-on-scroll">
      <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="text-left py-4 px-6 font-semibold text-primary text-sm uppercase tracking-wider">Attribute</th>
              <th class="text-left py-4 px-6 font-semibold text-primary text-sm uppercase tracking-wider">Standard</th>
            </tr>
          </thead>
          <tbody>
            {specs.map(([k, v], i) => (
              <tr class={`border-b border-gray-100 last:border-b-0 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'} hover:bg-accent/5 transition-colors`}>
                <td class="py-4 px-6 font-medium text-primary">{k}</td>
                <td class="py-4 px-6 text-gray-600">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="text-center mt-12 animate-on-scroll">
      <a href="/contact/" class="btn-primary text-lg group">
        Request Wholesale Pricing
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>

</PageLayout>
