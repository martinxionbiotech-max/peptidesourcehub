---
import PageLayout from "../../layouts/PageLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import RuoNotice from "../../components/RuoNotice.astro";
import { getCollection } from "astro:content";
import {
  CATALOG_PRICE_TEXT,
  DATASET_DESCRIPTION,
  DATASET_KEYWORDS,
  DATASET_NAME,
  DATASET_PATH,
  DATASET_VARIABLES,
  priceBand,
  productOffers,
} from "../../data/pricing";

const allProducts = await getCollection("products");
const recordCount = allProducts.length;
const catCount = (slug: string) => allProducts.filter((p) => p.data.category === slug).length;
const collectionPageLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Research Peptides & HGH — Products Catalog",
  "description": "50+ research peptides in 6 categories. ≥99% HPLC purity, COA included, factory-direct pricing. BPC-157, TB-500, Semaglutide, Tirzepatide, GHK-Cu, HGH.",
    "hasPart": [
    { "@type": "Product", "name": "BPC-157", "sku": "bpc-157", "description": "Research-grade BPC-157 supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/bpc-157/", "image": ["https://peptidesourcehub.net/images/products/bpc-157-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/bpc-157/", priceBand("bpc-157")) },
    { "@type": "Product", "name": "TB-500", "sku": "tb-500", "description": "Research-grade TB-500 supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/tb-500/", "image": ["https://peptidesourcehub.net/images/products/tb-500-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/tb-500/", priceBand("tb-500")) },
    { "@type": "Product", "name": "Semaglutide", "sku": "semaglutide", "description": "Research-grade Semaglutide supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/semaglutide/", "image": ["https://peptidesourcehub.net/images/products/semaglutide-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/semaglutide/", priceBand("semaglutide")) },
    { "@type": "Product", "name": "Tirzepatide", "sku": "tirzepatide", "description": "Research-grade Tirzepatide supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/tirzepatide/", "image": ["https://peptidesourcehub.net/images/products/tirzepatide-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/tirzepatide/", priceBand("tirzepatide")) },
    { "@type": "Product", "name": "Cagrilintide", "sku": "cagrilintide", "description": "Research-grade Cagrilintide supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/cagrilintide/", "image": ["https://peptidesourcehub.net/images/products/cagrilintide-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/cagrilintide/", priceBand("cagrilintide")) },
    { "@type": "Product", "name": "Retatrutide", "sku": "retatrutide", "description": "Research-grade Retatrutide supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/retatrutide/", "image": ["https://peptidesourcehub.net/images/products/retatrutide-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/retatrutide/", priceBand("retatrutide")) },
    { "@type": "Product", "name": "GHK-Cu", "sku": "ghk-cu", "description": "Research-grade GHK-Cu supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/ghk-cu/", "image": ["https://peptidesourcehub.net/images/products/ghk-cu-bottle.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/ghk-cu/", priceBand("ghk-cu")) },
    { "@type": "Product", "name": "HGH", "sku": "hgh", "description": "Research-grade HGH supplied with a lot-specific certificate of analysis; for laboratory research use only.", "url": "https://peptidesourcehub.net/products/hgh/", "image": ["https://peptidesourcehub.net/images/products/hgh.webp"], "brand": { "@type": "Brand", "name": "Peptides Source Hub" }, "offers": productOffers("https://peptidesourcehub.net/products/hgh/", priceBand("hgh")) },
  ],
};

/**
 * 数据集结构化数据。
 *   · 供 Google 数据集搜索；
 *   · 同时给 AI 检索与采购自动化一个可引用的机器可读数据源（文件由 /data/peptides.{csv,json} 构建产出）。
 */
const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": DATASET_NAME,
  "description": DATASET_DESCRIPTION,
  "url": "https://peptidesourcehub.net/products/",
  "license": "https://peptidesourcehub.net/terms/",
  "creator": { "@type": "Organization", "name": "Peptides Source Hub", "url": "https://peptidesourcehub.net" },
  "isAccessibleForFree": true,
  "keywords": DATASET_KEYWORDS,
  "variableMeasured": DATASET_VARIABLES,
  "distribution": [
    { "@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": `https://peptidesourcehub.net${DATASET_PATH.csv}` },
    { "@type": "DataDownload", "encodingFormat": "application/json", "contentUrl": `https://peptidesourcehub.net${DATASET_PATH.json}` },
  ],
};

const jsonLd = [collectionPageLd, datasetLd];

const categories = [
  { name:"Metabolic Research", slug:"metabolic", desc:"GLP-1 agonists & metabolic peptides", icon:"🧬", count:catCount("metabolic"), color:"from-emerald-500 to-teal-600" },
  { name:"Healing & Recovery", slug:"healing-recovery", desc:"Tissue repair & regeneration peptides", icon:"🩹", count:catCount("healing-recovery"), color:"from-blue-500 to-indigo-600" },
  { name:"Cosmetic & Skin", slug:"cosmetic-skin", desc:"Dermatological & anti-aging research", icon:"✨", count:catCount("cosmetic-skin"), color:"from-pink-500 to-rose-600" },
  { name:"Muscle Growth", slug:"muscle-growth", desc:"GH/IGF-1 axis & anabolic peptides", icon:"💪", count:catCount("muscle-growth"), color:"from-orange-500 to-red-600" },
  { name:"Nootropic & Anti-Aging", slug:"nootropic-anti-aging", desc:"Cognitive & longevity research tools", icon:"🧠", count:catCount("nootropic-anti-aging"), color:"from-violet-500 to-purple-600" },
  { name:"Specialty Stacks", slug:"specialty-stacks", desc:"Pre-formulated research combinations", icon:"⚡", count:catCount("specialty-stacks"), color:"from-amber-500 to-yellow-600" },
];
---

<PageLayout title="Research Peptides & HGH — Products Catalog" description="50+ research peptides in 6 categories. ≥99% HPLC purity, COA included, factory-direct pricing. BPC-157, TB-500, Semaglutide, Tirzepatide, GHK-Cu, HGH." {jsonLd}>
<RuoNotice />

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 text-center relative z-10 animate-on-scroll">
    <h1 class="text-white text-4xl md:text-5xl">Research Peptides & HGH</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl mx-auto">{recordCount} catalogued peptides across 6 research categories. ≥99% HPLC purity standard. Every kit includes a Certificate of Analysis. Factory-direct from Shenzhen.</p>
    <p class="mt-3 text-gray-200 text-sm">Wholesale list price: {CATALOG_PRICE_TEXT}</p>
    <div class="flex flex-wrap justify-center gap-3 mt-6">
      {["≥99% HPLC","COA with every order","Batch traceability","Tiered pricing"].map(b=>(<span class="px-3 py-1 rounded-full bg-white/10 text-gray-200 text-xs">{b}</span>))}
    </div>
    <div class="mt-6">
      <a href="/download/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-6 py-3 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download Product List & Price (PDF)
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="text-center mb-12">
      <h2>6 Research Categories</h2>
      <p class="text-gray-500 mt-2 max-w-xl mx-auto">Every category includes detailed product specifications, research data tables, and pricing tiers. Click any category to explore.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {categories.map((cat) => (
        <a href={`/products/${cat.slug}/`} class={`card group p-6 hover:-translate-y-2 transition-all duration-300 overflow-hidden relative`}>
          <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${cat.color}`}></div>
          <div class="flex items-start gap-4"><span class="text-3xl">{cat.icon}</span><div>
            <h3 class="font-bold text-lg group-hover:text-accent transition-colors">{cat.name}</h3>
            <p class="text-gray-500 text-sm mt-1">{cat.desc}</p>
            <span class="inline-block mt-3 text-xs text-accent-dark font-medium">{cat.count} products →</span>
          </div></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section bg-surface dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-2">Featured Products</h2>
    <p class="text-center text-gray-500 text-sm mb-8 max-w-xl mx-auto">Four entries from across the catalog. Each card opens the product page, where kit configurations, specification tables and bulk pricing tiers are listed.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 stagger-children">
      {[
        ["BPC-157","Pentadecapeptide","Healing & Recovery","/products/bpc-157/"],
        ["Semaglutide","GLP-1 Agonist","Metabolic","/products/semaglutide/"],
        ["Tirzepatide","Dual GIP/GLP-1","Metabolic","/products/tirzepatide/"],
        ["GHK-Cu","Copper Tripeptide","Cosmetic & Skin","/products/ghk-cu/"],
      ].map(([name,type,cat,url]) => (
        <a href={url} class="card p-5 text-center group hover:border-accent/30">
          <div class="w-12 h-12 mx-auto mb-3 rounded-xl bg-accent/10 flex items-center justify-center text-accent text-lg font-bold">{name.slice(0,1)}</div>
          <h3 class="font-bold group-hover:text-accent">{name}</h3>
          <p class="text-gray-500 text-xs">{type} · {cat}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4 text-center">
    <h2 class="mb-6">Why Buyers Choose Our Products</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      {[
        ["Quality First","Every batch is HPLC-tested to ≥99% purity and MS-verified for molecular weight. COA is batch-specific — never a generic template. We've shipped over 5,000 kits with zero customer rejections for quality defects."],
        ["Factory-Direct Pricing","No middlemen. You buy from the manufacturer. Tiered pricing starts at 10% off from 5 kits and scales to 30% off at 50+ kits. Annual contracts for recurring buyers. Transparent, published tiers."],
        ["Documentation Excellence","COA, MSDS, commercial invoice, and packing list with every shipment. Additional documentation (stability data, residual solvents, endotoxin) on request. Batch traceability: every kit maps to the original QC data file."],
      ].map(([t,d])=>(
        <div class="card p-5"><h3 class="font-bold mb-2 text-sm">{t}</h3><p class="text-gray-600 text-xs">{d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4 text-center">
    <h2 class="mb-4">Comparing products before you buy</h2>
    <p class="text-gray-600 mb-6 text-sm">
      Five groups of molecules that are easy to confuse: GHRP-2 / GHRP-6 / Ipamorelin, CJC-1295 with and without DAC,
      Selank vs Semax, Argireline vs SNAP-8 and BPC-157 vs TB-500. Each comparison page states the published source for
      every difference it claims.
    </p>
    <a href="/products/compare/" class="btn-outline">Open the comparison hub</a>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="max-w-3xl">
      <h2 class="mb-4">How to shortlist a SKU</h2>
      <p class="text-gray-600 mb-6 text-sm">
        Four questions decide most of the shortlist before price becomes relevant. Settle them in this order,
        and the catalog usually narrows to two or three entries.
      </p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-gray-100">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-left">
            <th scope="col" class="py-3 px-4 font-semibold">Dimension</th>
            <th scope="col" class="py-3 px-4 font-semibold">Question to settle</th>
            <th scope="col" class="py-3 px-4 font-semibold">What to record</th>
            <th scope="col" class="py-3 px-4 font-semibold">What it changes</th>
          </tr>
        </thead>
        <tbody>
          {[
            ["Research stage", "Exploratory assay, or a protocol with fixed readouts?", "The assay, the matrix, and whether a single lot has to cover the whole study.", "Assay design decides kit size, and whether holding one lot for the whole study is worth asking about."],
            ["Quantity", "One evaluation kit, or a study-sized shipment?", "Kits per shipment, the volume you expect to repeat, and whether lots may be mixed.", "Volume sets the pricing tier, the shipping configuration and the documentation included."],
            ["Documentation", "COA only, or the full analytical package?", "Which tests your reviewer expects: HPLC, MS, endotoxin, residual solvents or amino acid analysis.", "Additional tests are requested at inquiry and run before dispatch, so they extend the timeline."],
            ["Lead time", "When does the protocol start?", "Required arrival date, destination country, and whether a specific lot is acceptable.", "A fixed start date eliminates SKUs that cannot be dispatched in time."],
          ].map(([dimension, question, record, changes], i) => (
            <tr class={i % 2 === 0 ? "bg-white" : "bg-gray-50/50"}>
              <td class="py-3 px-4 font-semibold text-primary align-top">{dimension}</td>
              <td class="py-3 px-4 text-gray-600 align-top">{question}</td>
              <td class="py-3 px-4 text-gray-600 align-top">{record}</td>
              <td class="py-3 px-4 text-gray-500 align-top text-xs">{changes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-gray-500 text-xs mt-3 max-w-3xl">
      Lead time is confirmed per quotation, not per catalog page. Dispatch depends on the lot, the
      documentation set and the destination, and transit estimates come from the carrier rather than from us.
      If a date is fixed, say so at the shortlist stage — it changes which SKUs are realistic.
    </p>

    <div class="max-w-3xl mt-12">
      <h2 class="mb-4">What to send in an RFQ</h2>
      <p class="text-gray-600 mb-5 text-sm">
        An RFQ that answers these six points can usually be quoted without a follow-up round. A missing destination or label
        requirement adds a round trip before a quotation can be issued.
      </p>
      <ul class="space-y-3">
        {[
          ["Product", "Catalog name, CAS number or sequence, and the SKU if you already have it."],
          ["Quantity", "Kits or vials per shipment, plus the volume you expect to repeat."],
          ["Destination", "Country and postcode. Routing, duties and transit estimates all follow from them."],
          ["Documentation", "COA only, or HPLC, MS, endotoxin, residual solvents, amino acid analysis, or stability data."],
          ["Labeling", "Catalog label, neutral outer label, or private-label artwork for review."],
          ["Timeline", "The date you need the material in hand, and any lot or specification constraint."],
        ].map(([label, detail]) => (
          <li class="flex items-start gap-3">
            <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-accent mt-2"></span>
            <p class="text-gray-600 text-sm"><span class="font-semibold text-primary">{label}:</span> {detail}</p>
          </li>
        ))}
      </ul>
      <p class="text-gray-500 text-xs mt-5">
        Send it through the contact page, or reply to an existing quotation thread. The price list and the reference
        dataset are downloadable, so cite the file version if you are working from an older copy.
      </p>
    </div>
  </div>
</section>

<section class="section bg-surface">
  <div class="container-narrow mx-auto px-4 text-center">
    <h2 class="mb-4">Peptide Reference Data</h2>
    <p class="text-gray-600 mb-6 text-sm">
      Specification data for all {recordCount} catalog peptides — CAS number, molecular formula, molecular weight,
      amino acid sequence, HPLC purity criterion, appearance, solubility, storage and kit configurations — published
      as a machine-readable dataset for lab documentation, evaluation and automated sourcing workflows.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={DATASET_PATH.csv} download class="btn-outline">Download CSV</a>
      <a href={DATASET_PATH.json} download class="btn-outline">Download JSON</a>
    </div>
  </div>
</section>

<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Place an Order?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Browse our categories above or contact us directly for a wholesale quote. Quotes sent within 24 hours.</p>
    <a href="/contact/" class="btn-primary text-lg group">Request Wholesale Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
  </div>
</section>
  <BreadcrumbSchema items={[{ name: "Home", url: "https://peptidesourcehub.net/" }, { name: "Products", url: "https://peptidesourcehub.net/products/" }, { name: "Products", url: "https://peptidesourcehub.net/products/" }]} />
</PageLayout>