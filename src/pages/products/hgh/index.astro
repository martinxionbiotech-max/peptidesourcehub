  ["Isoelectric Point","~5.2"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Sterile water or bacteriostatic water; gentle swirling"],
  ["Storage","2–8°C (lyophilized); use promptly after reconstitution"],
];

const configs = [
  ["100 IU Kit","10 IU (~3.3mg) × 10 vials","100 IU","Evaluation; small-scale research"],
  ["150 IU Kit","15 IU (~5mg) × 10 vials","150 IU","Medium-scale protocols"],
  ["200 IU Kit","20 IU (~6.7mg) × 10 vials","200 IU","High-throughput; bulk research"],
  ["Custom","Custom IU × custom vials","Custom","OEM; specific protocols"],
];

const physiology = [
  ["Skeletal System","Linear bone growth (pre-pubertal); ↑ BMD","IGF-1 → chondrocyte & osteoblast stimulation"],
  ["Skeletal Muscle","↑ protein synthesis; ↑ lean body mass","IGF-1 + direct GH amino acid transport effects"],
  ["Adipose Tissue","↑ lipolysis; ↓ lipogenesis","Direct GH receptor activation on adipocytes"],
  ["Liver","IGF-1 production; ↑ gluconeogenesis","GH→JAK-STAT→IGF-1 transcription"],
