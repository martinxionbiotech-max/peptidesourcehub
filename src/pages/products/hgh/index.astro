  "sku": "PSH-HGH-100IU",
  "manufacturer": { "@type": "Organization", "name": "Peptide Source Hub" },
};

const specs = [
  ["CAS Number","12629-01-5"],
  ["Sequence","191-amino acid polypeptide with 2 disulfide bonds (Cys⁵³-Cys¹⁶⁵, Cys¹⁸²-Cys¹⁸⁹)"],
  ["Molecular Formula","C₉₉₀H₁₅₂₈N₂₆₂O₃₀₀S₇"],
