    <div class="float-right ml-4 mb-4 hidden sm:block w-32 h-32 rounded-2xl bg-accent/10 border-2 border-accent/30 flex items-center justify-center shadow-lg"><svg class="w-10 h-10 text-accent/60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg></div>
    <h1 class="text-white text-3xl md:text-5xl">HGH Wholesale</h1>
