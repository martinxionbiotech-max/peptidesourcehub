  "sku": "PSH-TB4-5MG",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "Contact",
    "highPrice": "Contact",
    "offerCount": "5"
  },
  "manufacturer": { "@type": "Organization", "name": "Peptides Source Hub" },
};

const specs = [
  ["CAS Number","77591-33-4"],
  ["Sequence","Ac-SDKPDMAEIEKFDKSKLKKTETQEKNPLPSKETIEQEKQAGES-OH"],
  ["Amino Acids","43"],
  ["Molecular Formula","C₂₁₂H₃₅₀N₅₆O₇₈S"],
  ["Molecular Weight","~4,963.5 Da"],
  ["Appearance","White to off-white lyophilized powder"],
  ["Purity","≥99% by HPLC"],
  ["Solubility","Soluble in sterile water or PBS"],
  ["Storage","2–8°C, desiccated, protect from light"]
];

const configs = [
  ["Standard Kit","5 mg × 10 vials","Tissue regeneration models; evaluation"],
  ["Custom","Custom mg × custom vials","OEM; private-label; bulk research"]
];

const focusAreas = [
  ["Angiogenesis","Endothelial cell migration & capillary tube formation in wound models"],
  ["Dermal Wound Healing","Keratinocyte migration; accelerated re-epithelialization"],
  ["Cardiac Protection","Cardiomyocyte survival post-ischemia; Akt activation"],
  ["Inflammation Resolution","NF-κB suppression; M2 macrophage polarization"],
  ["Hair Follicle Cycling","Dermal papilla cell activation; anagen phase promotion"]
];

const mechanisms = [
  ["G-Actin Sequestration","1:1 binding to monomeric actin (Kd ~0.7 μM) → maintains actin monomer pool for rapid filament assembly"],
  ["Cell Migration","Actin dynamics → lamellipodia formation in keratinocytes and endothelial cells"],
  ["Anti-Apoptotic Signaling","Akt/Bad pathway activation → mitochondrial outer membrane stabilization"],
  ["Anti-Inflammatory","Reduces TNF-α, IL-6; promotes M2 macrophage polarization via NF-κB modulation"]
];

const qcSpecs = [
  ["Purity","HPLC at 214 nm, C18 column","≥99.0% peak area"],
  ["Identity (MW)","ESI-MS","~4,963.5 ± 1.0 Da"],
  ["Appearance","Visual inspection","White to off-white powder"],
  ["Peptide Content","Amino acid analysis","≥80% net peptide"],
  ["Residual Moisture","Karl Fischer","≤3%"]
];

const pricing = [
  ["1 kit","List price","Evaluation; competitive analysis"],
  ["5+ kits","10% off","Initial portfolio expansion"],
  ["20+ kits","20% off","Mid-size distributors"],
  ["50+ kits","30% off","Regional distributors"],
];

const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": "What is the difference between TB-500 and Thymosin Beta-4?", "acceptedAnswer": { "@type": "Answer", "text": "TB-500 is the synthetic N-terminal fragment (Ac-LKKTETQ, ~889 Da) of the full 43-amino acid Thymosin Beta-4 protein. TB-500 retains the core actin-binding motif but lacks the full C-terminal regulatory sequence. Thymosin Beta-4 is the complete native protein with broader biological activity including additional binding domains and post-translational interaction sites." } },
    { "@type": "Question", "name": "What research applications is Thymosin Beta-4 used for?", "acceptedAnswer": { "@type": "Answer", "text": "Primarily wound healing, angiogenesis, cardiac protection, and tissue regeneration research. Its actin-sequestering activity makes it a key tool in cytoskeletal dynamics studies. Also investigated in dermal repair, corneal healing, and hair follicle biology." } },
    { "@type": "Question", "name": "How should Thymosin Beta-4 be stored and reconstituted?", "acceptedAnswer": { "@type": "Answer", "text": "Reconstitute with sterile water or PBS (pH 7.0–7.4). The full-length protein is slightly more complex to handle than TB-500 due to its larger size. Aliquot single-use portions and store at -20°C. Avoid freeze-thaw cycles. Lyophilized powder: 24-month stability at 2–8°C." } },
    { "@type": "Question", "name": "Is Thymosin Beta-4 the same as Thymosin α1?", "acceptedAnswer": { "@type": "Answer", "text": "No. Thymosin α1 (28 amino acids, ~3,108 Da) and Thymosin β4 (43 amino acids, ~4,964 Da) are distinct proteins with different biological roles. Thymosin α1 is primarily immunomodulatory, while Thymosin β4 is primarily involved in actin dynamics and tissue repair." } },
    { "@type": "Question", "name": "Do you offer custom Thymosin Beta-4 configurations?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Standard kit is 5mg × 10 vials. Custom mg per vial and vial count available for qualifying wholesale orders. Contact us for a custom quotation including private-label options." } }]};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peptidesourcehub.net/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://peptidesourcehub.net/products/" },
    { "@type": "ListItem", "position": 3, "name": "Healing &amp; Recovery", "item": "https://peptidesourcehub.net/products/healing-recovery/" },
    { "@type": "ListItem", "position": 4, "name": "Thymosin Beta-4" }
  ]
};

const allJsonLd = [jsonLd, faqJson, breadcrumbLd];
